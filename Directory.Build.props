<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Trailing separator matters: references are written as $(SimHubDir)Name.dll -->
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub\</SimHubDir>
  </PropertyGroup>

  <!-- Per-machine override, not committed. Copy Directory.Build.props.user.example to
       Directory.Build.props.user and point SimHubDir at your install. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

</Project>
