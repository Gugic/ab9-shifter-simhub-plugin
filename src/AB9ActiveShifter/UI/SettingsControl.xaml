<UserControl x:Class="AB9ActiveShifter.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:local="clr-namespace:AB9ActiveShifter.UI"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <styles:SHTabControl>

        <!-- ============================ SETUP ============================ -->
        <styles:SHTabItem Header="Setup">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="PROFILE &amp; PATTERN" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ProfileCombo" Width="220" Margin="0,0,8,0" IsEditable="True"
                                          SelectionChanged="OnProfileSelected" />
                                <styles:SHButtonSecondary Click="OnAddProfile" Content="Duplicate" Padding="10,3" Margin="0,0,6,0" />
                                <styles:SHButtonSecondary Click="OnRenameProfile" Content="Rename" Padding="10,3" Margin="0,0,6,0" />
                                <styles:SHButtonSecondary Click="OnDeleteProfile" Content="Delete" Padding="10,3" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="220" SelectedIndex="{Binding PatternIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="H pattern, 7 gears + R (lockout)" />
                                    <ComboBoxItem Content="H pattern, 6 gears + R (no 7th slot)" />
                                    <ComboBoxItem Content="H pattern, 5 gears + R" />
                                    <ComboBoxItem Content="Sequential (+ / -)" />
                                </ComboBox>
                            </StackPanel>
                            <ui:TitledSlider Title="Sequential pulse length (ms)" Minimum="20" Maximum="400"
                                             TickFrequency="10" ShowResetButton="True" ResetValue="120"
                                             Value="{Binding SeqPulseMs, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                                       Text="A profile holds every dial on every tab, the pattern included, so each pattern can carry its own tuning. Duplicate makes a copy of the current profile to experiment in; to rename, type the new name in the box and click Rename. Gears map to vJoy buttons 1..N with reverse as the highest; sequential pulses button 1 for upshift and button 2 for downshift, and its push resistance and click are the detent dials on the Feel tab." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="STATUS" ShowSeparator="True">
                        <StackPanel x:Name="StatusPanel" Margin="0,4,0,8">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="{Binding DeviceText}" Margin="0,2" />
                                <TextBlock Text="{Binding VJoyText}" Margin="0,2" />
                                <TextBlock Text="{Binding GearText}" Margin="0,2" />
                                <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                            </UniformGrid>
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="ENABLE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                     Content="Shifter force feedback enabled" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                       Text="Off by default. Enabling takes the base exclusively and starts applying force, so work through the checklist below first and have a hand on the stick. Turn it off again to give the base back to MOZA Pit House or another program." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="FREE STICK" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FreeStick, Mode=TwoWay}"
                                                     Content="Release all forces (free stick)" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                       Text="Holds the base but applies nothing, so you can feel how the stick moves on its own. Any resistance left with this on is coming from the hardware, not from the gate - almost always the base's own centring, which only MOZA Cockpit's Spring setting can switch off. This base centres in firmware and ignores DirectInput's request to stop." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="BEFORE YOU START" ShowSeparator="True">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85">
                            1. In MOZA Cockpit, once: FFB Mode = DirectInput, Spring = 0, Base Force Model = Flight Base, Max Torque and Overall Intensity 100%. Without this the base fights the gate with its own centring.<LineBreak />
                            2. Fully exit MOZA Cockpit, and close any Pit House live-tuning page. They hold the stick exclusively and this plugin cannot open it while they do.<LineBreak />
                            3. Disable Steam Input for the AB9, or close Steam.<LineBreak />
                            4. Create a vJoy device with at least 8 buttons in vJoyConf.<LineBreak />
                            5. Run the polarity calibration below, before turning the force up.<LineBreak />
                            6. In your game, bind gears 1-7 and reverse to vJoy buttons 1-8, and do not bind the AB9 axes.
                        </TextBlock>
                    </styles:SHSection>

                    <styles:SHSection Title="POLARITY CALIBRATION" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                       Text="Some AB9 firmware versions apply DirectInput effects backwards, which would turn a centring spring into one that throws the stick at its stops. Until this is measured the plugin caps its force at 10%." />
                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                       Text="Calibration applies a short push each way and watches which way the stick actually moves, so it works even though the base holds itself centred. Take your hands off the stick and leave them off - anything resisting the stick will spoil the measurement. It takes about four seconds." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <styles:SHButtonPrimary x:Name="CalibrateButton" Click="OnCalibrate"
                                                        Content="Measure polarity" Margin="0,0,8,0" Padding="14,4" />
                                <styles:SHButtonSecondary x:Name="CancelCalibrationButton" Click="OnCancelCalibration"
                                                          Content="Cancel" Padding="14,4" />
                            </StackPanel>

                            <Border x:Name="CalibrationResultBorder" Padding="10,8" Margin="0,0,0,8"
                                    Background="#22FFFFFF" CornerRadius="3" Visibility="Collapsed">
                                <StackPanel x:Name="CalibrationResultPanel" />
                            </Border>

                            <ui:TitledSlider Title="Calibration force (%)" Minimum="5" Maximum="60" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding CalibrationForcePct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,10"
                                       Text="Raise this only if calibration reports that the stick barely moved. First check that nothing is touching the stick, and that the base's own Spring is 0 in MOZA Cockpit - Pit House has no such setting in flight mode." />

                            <styles:SHExpander Header="Manual overrides">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                               Text="Calibration sets these four from measurement. They are separate because this base does not treat the axes alike - it can invert the push on one axis and the spring on the other." />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantX, Mode=TwoWay}"
                                                             Content="Invert push, left/right" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantY, Mode=TwoWay}"
                                                             Content="Invert push, forward/back" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertSpringX, Mode=TwoWay}"
                                                             Content="Invert spring, left/right" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertSpringY, Mode=TwoWay}"
                                                             Content="Invert spring, forward/back" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding PolarityConfirmed, Mode=TwoWay}"
                                                             Content="Polarity confirmed - remove the 10% force cap"
                                                             Margin="0,8,0,0" />
                                </StackPanel>
                            </styles:SHExpander>

                            <styles:SHExpander Header="Gear layout">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                               Text="Pure preference: which end of the gate is first gear. Flip these if the gears come out mirrored from where your hand expects them." />
                                    <styles:SHToggleCheckbox IsChecked="{Binding MirrorColumns, Mode=TwoWay}"
                                                             Content="First gear on the right instead of the left" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding MirrorSlots, Mode=TwoWay}"
                                                             Content="Odd gears toward me instead of away" Margin="0,2" />
                                </StackPanel>
                            </styles:SHExpander>

                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75"
                                       Text="Once calibration succeeds the cap lifts by itself. Raise the overall gain slowly afterwards: this is a 12 Nm base." />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- ============================= FEEL ============================= -->
        <styles:SHTabItem Header="Feel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="MASTER" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Overall gain (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding OverallGainPct, Mode=TwoWay}" />
                            <TextBlock x:Name="LockoutSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                            <styles:SHButtonSecondary Click="OnResetForces" Content="Reset forces to defaults"
                                                      Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="GATE WALLS" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="Every wall is a percentage of full force, so 90% is a wall you cannot push through by hand. These are the same kind of force as the lockout, which is why they can be made properly solid." />

                            <ui:TitledSlider Title="Gate wall, between columns (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="90"
                                             Value="{Binding ChannelWallForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Slot wall, once in a gear (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="90"
                                             Value="{Binding ColumnPinForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Slot width, free corridor (axis counts)" Minimum="0" Maximum="2400"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="1100"
                                             Value="{Binding SlotHalfWidth, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="A slot is a corridor with walls, not a pull toward its centre line. If a middle gear shakes while seated, widen this: a narrow corridor leaves the stick balanced on a point it can hunt around. The outer gears never shake because their wall only pushes one way, against the end of travel. Zero is the rail gate: the lever pulled straight onto the column line, like the native shifter mode - stable only with a moderate slot wall, so if a railed gear trembles, lower the wall force first." />
                            <ui:TitledSlider Title="Tunnel depth, free corridor (axis counts)" Minimum="0" Maximum="4000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Value="{Binding ChannelFreeDepth, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The fore/aft twin of the slot width: how deep the tunnel stays free before its centring force begins. Zero closes the last free space in the gate, so the lever is guided on exactly one axis everywhere - together with zero slot width this is the native shifter-mode topology. Values above the neutral channel enter band are capped to it." />
                            <ui:TitledSlider Title="Fore/aft drag while on a column (%)" Minimum="0" Maximum="40"
                                             TickFrequency="1" ShowResetButton="True" ResetValue="5"
                                             Value="{Binding ChannelGuideForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Wall bite distance (axis counts)" Minimum="60" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="600"
                                             Value="{Binding WallRamp, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Wall attack (ms to full force, 0 = off)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="0"
                                             Value="{Binding WallAttackMs, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Rebound absorption (%)" Minimum="0" Maximum="80" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="45"
                                             Value="{Binding WallYieldPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Damping (%)" Minimum="0" Maximum="80" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding DampingPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="A wall is flat past its bite, so the bite is where all trouble lives. Too short and it is a step - contact kicks, and a light press vibrates against it; too long and the wall goes spongy and can buzz. Raise the bite until the vibration stops, and no further. Wall attack is a second dial in time instead of space: force builds over these milliseconds on contact, releases instantly, and freezes while you press and hold still. Try 10-25 if short bites kick or corners hammer. Rebound absorption drains what a bounce returns; damping thickens the lever but cannot fix a buzz alone. The attack shapes walls only - the lockout, humps and detents stay sharp so speed cannot slip past them." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLOT MOUTHS" ShowSeparator="True"
                                      Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="The ends of the dividers between slots, where they meet the neutral tunnel. Square is the plain rectangular notch the gate has always had. The other two open the slot out toward the tunnel, which a hand reads as an eased or a chamfered edge - they only ever remove force, never add it, so the shaping guides rather than shoves." />

                            <TextBlock Text="Mouth shape" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding MouthShapeIndex, Mode=TwoWay}" Margin="0,0,0,8"
                                      HorizontalAlignment="Left" MinWidth="240">
                                <ComboBoxItem Content="Square - a plain notch (default)" />
                                <ComboBoxItem Content="Rounded - filleted on both sides" />
                                <ComboBoxItem Content="Angled - chamfered toward the next gear" />
                            </ComboBox>

                            <ui:TitledSlider Title="Mouth reach down the slot (axis counts)" Minimum="1000" Maximum="12000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="5000"
                                             Value="{Binding MouthDepth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Mouth opening (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="100"
                                             Value="{Binding MouthOpenPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Reach is what decides whether the shaping is felt at all. The base takes three to four milliseconds to answer, in which a lever being shifted covers fifteen hundred counts or more - so shaping confined to a shorter stretch than that is over before a single corrected force arrives. Several thousand counts spans the whole withdrawal stroke. Opening is a share of what the geometry safely allows, so it can never reach the next column's slot or the lockout's band. Angled opens one side only, toward the next gear in sequence, and does nothing at all where there is no next gear or where the crossing is the lockout." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLIDING ACROSS THE GATE" ShowSeparator="True"
                                      Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="What the hand feels moving along the neutral channel: a light pull into each column, a hump to climb between the ordinary columns, and the lockout gate before 7/R - a one-way fight, flat toward the main gears across a compact band, so a fast flick pays the same price as a slow push. Leaving 7/R is assisted, like a real range gate. Its width times its force is the toll: if slams still get through, widen or strengthen it." />

                            <ui:TitledSlider Title="Lockout gate, guarding the R column (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="70"
                                             Visibility="{Binding HasLockout, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding LockoutForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Lockout gate half-width (axis counts)" Minimum="500" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2200"
                                             Visibility="{Binding HasLockout, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding LockoutHalfWidth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Humps between the other columns (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="15"
                                             Value="{Binding BarrierForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Hump width (axis counts)" Minimum="400" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2500"
                                             Value="{Binding BarrierWidth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Pull into a column (%)" Minimum="0" Maximum="60"
                                             TickFrequency="1" ShowResetButton="True" ResetValue="12"
                                             Value="{Binding ColumnDetentForcePct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The pull into a column is light while you slide along the channel and rises in one straight line to the full slot wall by the time you have left it, so the same dial also sets how firmly an entry taken slightly off a column is steered onto its slot. There is no force at all across a column's own width, so it guides without giving the lever a centre line to hunt around. It has no separate funnel strength: a second waypoint would either make one leg steeper than the walls or land exactly on this line." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLOT DETENT" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Resistance entering the slot (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="22"
                                             Value="{Binding DetentResistPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Pull into the slot, the snick (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="35"
                                             Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding DetentPullPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Seated hold, keeps the gear in (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="55"
                                             Value="{Binding DetentHoldPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The seated hold has to beat whatever the base does by itself. A base that is still self-centring pulls hard at full deflection, and a light hold loses to it - the gear simply falls back out." />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- =========================== GEOMETRY =========================== -->

        <styles:SHTabItem Header="Geometry">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="FORCE SHAPING" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Gate wall fade width, across a column (axis counts)" Minimum="200" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="1500"
                                             Value="{Binding WallBlend, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="How far sideways it takes the fore/aft gate wall to go from open, on a column, to solid between columns. This is the mouth of each slot seen from the tunnel: narrow and the gate snaps shut as you leave a column, wide and every entry feels vague. It is a sideways gradient, so it is also what corners are made of - widen it if corners feel harsh." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="The lateral guide has no ramp of its own any more. Every sideways force in the gate - the pull along the tunnel, the funnel into a slot, the slot wall itself - now rises at the same stiffness as the wall, so a gentler force gets a shorter face instead of a steeper one. Its own ramp was a free parameter, and at the bottom of its range it made the funnel the steepest thing in the gate, three and a half times the wall face, in exactly the place the lever crosses on every shift." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                       Text="The lockout gate places itself: it sits just outside the band of the last main-section column, so sliding across the gate meets it straight away instead of after a long stretch of dead travel. Its width is on the Feel tab, and the Monitor tab draws the band where it actually is." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHExpander Header="Advanced gate geometry">
                        <StackPanel Margin="0,8,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="Axis positions run 0 to 65535 with 32767 at centre. Every pair is enter/exit hysteresis: the exit value must be the looser one." />

                            <ui:TitledSlider Title="Neutral channel half-width (enter)" Minimum="200" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Value="{Binding ChannelHalfEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Neutral channel half-width (exit)" Minimum="200" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="5200"
                                             Value="{Binding ChannelHalfExit, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Outer column band (enter)" Minimum="500" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Value="{Binding ColumnEdgeEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Outer column band (exit)" Minimum="500" Maximum="12000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="5000"
                                             Value="{Binding ColumnEdgeExit, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Inner column half-width (enter)" Minimum="300" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="1200"
                                             Value="{Binding ColumnInnerHalfEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Inner column half-width (exit)" Minimum="300" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2400"
                                             Value="{Binding ColumnInnerHalfExit, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Engage depth (from the end of travel)" Minimum="500" Maximum="28000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="4000"
                                             Value="{Binding EngageDepth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Release depth (from the end of travel)" Minimum="1000" Maximum="30000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="8000"
                                             Value="{Binding ReleaseDepth, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Both measure from the ends of travel, so raising them shortens the throw - centre is 32767, and the shift fires once the lever is within the engage depth of a stop. This is also the sequential lever's activation distance: its spring reaches full resistance exactly at the threshold and the click moves with it, so a short throw stays progressive. Keep the release depth 2000-4000 above the engage depth or the re-arm point sits on top of the firing point." />
                            <ui:TitledSlider Title="Neutral detent hysteresis" Minimum="0" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="400"
                                             Value="{Binding DetentHysteresis, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Ticks required to engage" Minimum="1" Maximum="20" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="2"
                                             Value="{Binding MinEngageTicks, Mode=TwoWay}" />
                        </StackPanel>
                    </styles:SHExpander>

                    <styles:SHExpander Header="Device and output">
                        <StackPanel Margin="0,8,0,8">
                            <ui:TitledSlider Title="vJoy device number" Minimum="1" Maximum="16" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="1"
                                             Value="{Binding VJoyDeviceId, Mode=TwoWay}" />
                            <ui:TitledSlider Title="FFB loop rate (Hz)" Minimum="100" Maximum="1000" TickFrequency="50"
                                             ShowResetButton="True" ResetValue="1000"
                                             Value="{Binding TickHz, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                       Text="The device is matched by USB vendor and product id. The AB9 is 346E / 1000; only change these if your base enumerates differently." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Vendor id" VerticalAlignment="Center" Width="80" />
                                <TextBox Text="{Binding VendorId, Mode=TwoWay}" Width="90" Margin="0,0,16,0" />
                                <TextBlock Text="Product id" VerticalAlignment="Center" Width="80" />
                                <TextBox Text="{Binding ProductId, Mode=TwoWay}" Width="90" />
                            </StackPanel>
                        </StackPanel>
                    </styles:SHExpander>

                    <styles:SHSection Title="RESET" ShowSeparator="True">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <styles:SHButtonSecondary Click="OnResetGeometry" Content="Reset geometry"
                                                      Padding="12,4" Margin="0,0,8,0" />
                            <styles:SHButtonSecondary Click="OnResetEverything" Content="Reset everything"
                                                      Padding="12,4" />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- =========================== MONITOR ============================ -->
        <styles:SHTabItem Header="Monitor">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <styles:SHSection Title="LIVE GATE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <local:GateVisualizer x:Name="Visualizer" Height="300" HorizontalAlignment="Left" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                       Text="The dot is the stick. The shaded band on the right is the lockout: in the neutral channel it pushes back toward the main gears until you push through into 7/R." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="READINGS" ShowSeparator="True">
                        <StackPanel x:Name="ReadingsPanel" Margin="0,4,0,8">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding AxisText}" Margin="0,2" />
                            <TextBlock Text="{Binding StateText}" Margin="0,2" />
                            <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="RECORD A TRACE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                       Text="Records every tick - position, speed and the exact force sent to the base - so a movement that feels wrong can be replayed and measured instead of described. Press record, make the movement that misbehaves, press stop, and tell me what you did. Two minutes maximum, then it stops on its own." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <styles:SHButtonPrimary x:Name="RecordButton" Click="OnToggleRecord"
                                                        Content="Start recording" Margin="0,0,8,0" Padding="14,4" />
                                <styles:SHButtonSecondary x:Name="OpenTracesButton" Click="OnOpenTraces"
                                                          Content="Open trace folder" Padding="14,4" />
                            </StackPanel>

                            <TextBlock x:Name="RecordStatus" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </styles:SHSection>
                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

    </styles:SHTabControl>
</UserControl>
