<UserControl x:Class="AB9ActiveShifter.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:local="clr-namespace:AB9ActiveShifter.UI"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <!--
            Applies to every ui:TitledSlider with no per-instance markup needed: a tooltip
            advertising the undo gesture, and the gesture-bracketing events that implement it.
            Gesture boundaries are bracketed by whichever gets there first - a mouse press or a
            key press - paired with its matching end event, so a five-second drag-and-hold is
            one adjustment and a quick +/- click is another, whatever the interaction.
            TitledSlider is SimHub's own compiled control, so none of this touches it directly -
            ToolTip is a plain FrameworkElement property any control accepts from outside.

            Deliberately NOT bracketed by Got/LostKeyboardFocus: those looked like they would
            also catch typing into the value box, but a real edit already starts with
            PreviewKeyDown (which fires on the element that already has focus), so the focus
            events added nothing real - and they actively broke undo. Right-clicking to open
            the context menu moves keyboard focus to the popup, and closing it - which happens
            right as "Undo to previous value" is clicked - hands focus back to the slider,
            firing GotKeyboardFocus a moment before the click handler runs and re-snapshotting
            the CURRENT (already-edited) value over the correct "previous" one. Confirmed via
            SimHub's log: "begin gesture ... snapshot=77" landing between "menu opened ...
            previous=100" and "undo: ... requested=77" - the undo was writing the value back
            to itself.

            The ContextMenu itself is built in code-behind (IndexSliders), not here: a XAML
            element with an inline event attribute (Click="...") placed inside
            UserControl.Resources - which is parsed before the SHTabControl root below it -
            shifts which element the compiler's connectionId numbering assigns to the root,
            throwing "Unable to cast ... MenuItem ... to ... SHTabControl" at load. EventSetter
            handlers below are unaffected: they resolve through the style engine, not through
            IComponentConnector.Connect.
        -->
        <Style TargetType="{x:Type ui:TitledSlider}">
            <Setter Property="ToolTip" Value="Right-click to undo the last adjustment." />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSliderGestureStartMouse" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSliderGestureEndMouse" />
            <EventSetter Event="PreviewKeyDown" Handler="OnSliderGestureStartKey" />
            <EventSetter Event="PreviewKeyUp" Handler="OnSliderGestureEndKey" />
        </Style>
    </UserControl.Resources>

    <styles:SHTabControl>

        <!-- ============================ SETUP ============================ -->
        <styles:SHTabItem Header="Setup">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="PROFILE &amp; PATTERN" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ProfileCombo" Width="220" Margin="0,0,8,0" IsEditable="True"
                                          SelectionChanged="OnProfileSelected" />
                                <styles:SHButtonSecondary Click="OnAddProfile" Content="Duplicate" Padding="10,3" Margin="0,0,6,0" />
                                <styles:SHButtonSecondary Click="OnRenameProfile" Content="Rename" Padding="10,3" Margin="0,0,6,0" />
                                <styles:SHButtonSecondary Click="OnDeleteProfile" Content="Delete" Padding="10,3" Margin="0,0,16,0" />
                                <styles:SHButtonSecondary Click="OnExportProfile" Content="Export..." Padding="10,3" Margin="0,0,6,0" />
                                <styles:SHButtonSecondary Click="OnImportProfile" Content="Import..." Padding="10,3" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="220" SelectedIndex="{Binding PatternIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="H pattern, 7 gears + R (lockout)" />
                                    <ComboBoxItem Content="H pattern, 6 gears + R (no 7th slot)" />
                                    <ComboBoxItem Content="H pattern, 5 gears + R" />
                                    <ComboBoxItem Content="Sequential (+ / -)" />
                                </ComboBox>
                            </StackPanel>
                            <ui:TitledSlider Title="Sequential pulse length (ms)" Minimum="20" Maximum="400"
                                             TickFrequency="10" ShowResetButton="True" ResetValue="120"
                                             Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding SeqPulseMs, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                                       Text="A profile holds every dial on every tab, the pattern included, so each pattern can carry its own tuning. Duplicate makes a copy of the current profile to experiment in; to rename, type the new name in the box and click Rename. Gears map to vJoy buttons 1..N with reverse as the highest; sequential pulses button 9 for upshift and button 10 for downshift - above every gear button, so no game binding can mean two things - and its push resistance and click are the detent dials on the Feel tab." />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
                                       Text="Export writes the current profile to a file you can share. Import always adds a new profile, numbering the name if it is taken, so someone else's tune can never land on top of yours. What travels is the tuning only: your measured polarity, your device and vJoy numbers and your loop rate stay as they are, values are range-checked on the way in, and an imported profile always arrives with forces off." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="STATUS" ShowSeparator="True">
                        <StackPanel x:Name="StatusPanel" Margin="0,4,0,8">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="{Binding DeviceText}" Margin="0,2" />
                                <TextBlock Text="{Binding VJoyText}" Margin="0,2" />
                                <TextBlock Text="{Binding GearText}" Margin="0,2" />
                                <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                            </UniformGrid>
                            <TextBlock x:Name="TabGateText" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" />
                            <TextBlock x:Name="VersionText" Margin="0,8,0,0" Opacity="0.6" />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="VJOY OUTPUT" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="VJoyCombo" Width="330" Margin="0,0,8,0"
                                          SelectionChanged="OnVJoyDeviceSelected" />
                                <styles:SHButtonSecondary Click="OnRefreshVJoyDevices" Content="Refresh" Padding="10,3" />
                            </StackPanel>
                            <TextBlock x:Name="VJoyHint" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"
                                       Text="Which virtual device carries the gears into your game. The list is what vJoy reports right now, so create or resize a device in vJoyConf and press Refresh. Ten buttons are wanted: gears take 1-8 and the sequential up/down take 9-10. Fewer still works for whatever fits - nothing here stops the gate itself, which needs no vJoy at all." />

                            <styles:SHExpander Header="Base device identity" Margin="0,8,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                               Text="The base is matched by USB vendor and product id, written in hex as Device Manager shows them. The AB9 is 346E / 1000; only change these if your base enumerates differently. This lives here rather than with the other advanced settings because a base that is not found is exactly the case where the tuning tabs are still hidden." />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Vendor id" VerticalAlignment="Center" Width="80" />
                                        <TextBox Text="{Binding VendorIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,16,0" />
                                        <TextBlock Text="Product id" VerticalAlignment="Center" Width="80" />
                                        <TextBox Text="{Binding ProductIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" />
                                    </StackPanel>
                                </StackPanel>
                            </styles:SHExpander>
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="ENABLE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                     Content="Shifter force feedback enabled" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                       Text="Off by default. Enabling takes the base exclusively and starts applying force, so work through the checklist below first and have a hand on the stick. Turn it off again to give the base back to MOZA Pit House or another program." />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                       Text="This is a 12 Nm base and this is third-party software driving it: if the lever ever shakes, kicks or drives itself to a stop, untick this - and if it will not stop, cut the base's power. Keep your face and free hand clear the first time you enable a profile you have not felt before. See ABOUT at the bottom of this tab." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="FREE STICK" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FreeStick, Mode=TwoWay}"
                                                     Content="Release all forces (free stick)" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                       Text="Holds the base but applies nothing, so you can feel how the stick moves on its own. Any resistance left with this on is coming from the hardware, not from the gate - almost always the base's own centring, which only MOZA Cockpit's Spring setting can switch off. This base centres in firmware and ignores DirectInput's request to stop." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="BEFORE YOU START" ShowSeparator="True">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85">
                            1. In MOZA Pit House, once: AB9 Mode = Flight Simulation Base. In Shifter mode the base runs its own gate and does not present the axes at all.<LineBreak />
                            2. In MOZA Cockpit, once: Force Feedback Mode = DirectInput, Spring = 0, Damper = 15%, and Maximum Torque Output, Overall Force Feedback Intensity and Game Force Feedback Gain at 100%. Without this the base fights the gate with its own centring.<LineBreak />
                            3. Fully exit both MOZA apps. They hold the stick exclusively and this plugin cannot open it while they do.<LineBreak />
                            4. Create a vJoy device with at least 10 buttons in vJoyConf (gears use 1-8, sequential up/down use 9-10), then pick it under vJoy output above.<LineBreak />
                            5. Run the polarity calibration below, before turning the force up.<LineBreak />
                            6. In your game, bind gears 1-7 and reverse to vJoy buttons 1-8, and do not bind the AB9 axes.
                        </TextBlock>
                    </styles:SHSection>

                    <styles:SHSection Title="POLARITY CALIBRATION" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">

                            <!-- Done: the measurement is a one-off, so once it has been made this
                                 collapses to its result and a way back in. -->
                            <StackPanel x:Name="CalibrationDonePanel" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock x:Name="CalibrationSummary" TextWrapping="Wrap" Opacity="0.85"
                                           Margin="0,0,0,8" />
                                <styles:SHButtonSecondary Click="OnRecalibrate" Content="Measure again"
                                                          Padding="14,4" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel x:Name="CalibrationFullPanel">
                                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                           Text="Some AB9 firmware versions apply DirectInput effects backwards, which would turn a centring spring into one that throws the stick at its stops. Until this is measured the plugin caps its force at 10%, and the tuning tabs stay hidden." />
                                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                           Text="Calibration applies a short push each way and watches which way the stick actually moves, so it works even though the base holds itself centred. Take your hands off the stick and leave them off - anything resisting the stick will spoil the measurement. It takes about four seconds." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <styles:SHButtonPrimary x:Name="CalibrateButton" Click="OnCalibrate"
                                                            Content="Measure polarity" Margin="0,0,8,0" Padding="14,4" />
                                    <styles:SHButtonSecondary x:Name="CancelCalibrationButton" Click="OnCancelCalibration"
                                                              Content="Cancel" Padding="14,4" />
                                </StackPanel>

                                <Border x:Name="CalibrationResultBorder" Padding="10,8" Margin="0,0,0,8"
                                        Background="#22FFFFFF" CornerRadius="3" Visibility="Collapsed">
                                    <StackPanel x:Name="CalibrationResultPanel" />
                                </Border>

                                <ui:TitledSlider Title="Calibration force (%)" Minimum="5" Maximum="60" TickFrequency="5"
                                                 ShowResetButton="True" ResetValue="10"
                                                 Value="{Binding CalibrationForcePct, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,10"
                                           Text="Raise this only if calibration reports that the stick barely moved. 10% is enough on this base - a probe stops the moment its direction is certain, so it needs a movement that can be read, not a large one. First check that nothing is touching the stick, and that the base's own Spring is 0 in MOZA Cockpit - Pit House has no such setting in flight mode." />
                            </StackPanel>

                            <styles:SHExpander Header="Manual overrides">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                               Text="Which way the base pushes when told to push. Calibration sets both from measurement; they are separate because this base does not treat the axes alike. Getting one wrong turns every wall on that axis into a shove toward the stops, so change them by hand only to undo an obviously wrong measurement." />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantX, Mode=TwoWay}"
                                                             Content="Invert push, left/right" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantY, Mode=TwoWay}"
                                                             Content="Invert push, forward/back" Margin="0,2" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                               Text="Calibration also probes the base with a spring on each axis, but there is no flag for it: every wall in this gate is a push, never a spring. Those two probes stay because a base that answers predictably on both kinds of effect is the evidence the force cap is waiting for." />
                                    <styles:SHToggleCheckbox IsChecked="{Binding PolarityConfirmed, Mode=TwoWay}"
                                                             Content="Polarity confirmed - remove the 10% force cap"
                                                             Margin="0,8,0,0" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                                               Text="Ticked by a calibration run in which all four probes gave a definite answer. Ticking it by hand puts the base to full force on an unmeasured polarity - the one case the cap exists for." />
                                </StackPanel>
                            </styles:SHExpander>

                            <styles:SHExpander Header="Gear layout">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                               Text="Pure preference: which end of the gate is first gear. Flip these if the gears come out mirrored from where your hand expects them." />
                                    <styles:SHToggleCheckbox IsChecked="{Binding MirrorColumns, Mode=TwoWay}"
                                                             Content="First gear on the right instead of the left" Margin="0,2" />
                                    <styles:SHToggleCheckbox IsChecked="{Binding MirrorSlots, Mode=TwoWay}"
                                                             Content="Odd gears toward me instead of away" Margin="0,2" />
                                </StackPanel>
                            </styles:SHExpander>

                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75"
                                       Text="Once calibration succeeds the cap lifts by itself. Raise the overall gain slowly afterwards: this is a 12 Nm base." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="ABOUT" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10"
                                       Text="It drives a 12 Nm active device, and the risk is yours. The AB9 is a servo strong enough to hurt a wrist and to slam its own stops. This plugin computes its forces in software, several milliseconds of USB away from the motor, and a force rendered through that delay can go unstable and oscillate on its own. A defect, an unlucky combination of settings, or a stalled loop can make the base shake, kick or drive to a stop with no warning, which can injure you and damage hardware. You run it at your own risk: there is no warranty of any kind, and nobody is liable for injury or for damage to your equipment. Forces starting off, the 10% cap until polarity is measured, and the watchdog all reduce that risk - they do not remove it." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10"
                                       Text="Unofficial. Not affiliated with, endorsed by or supported by MOZA, SimHub or vJoy. MOZA and AB9 are named here only to say which hardware this works with. Do not take a problem caused by this plugin to MOZA's support - a base running it is being driven by third-party software they did not write." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10"
                                       Text="Early software, in active development and nowhere near polished. It has been built and tuned against exactly one base on one firmware revision, so its behaviour on yours is genuinely untested, and defaults, dial names and saved settings can still change between versions." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.6"
                                       Text="MIT licensed. The full text, the trademark notices and the attributions ship beside the plugin in LICENSE and NOTICE.md. github.com/Gugic/ab9-shifter-simhub-plugin" />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- ============================= FEEL ============================= -->
        <styles:SHTabItem x:Name="FeelTab" Header="Feel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="MASTER" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Overall gain (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding OverallGainPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Scales everything the gate produces - walls, detents, the lockout and the telemetry buzzes alike - so it is the one dial to reach for if the whole shifter is too strong or too weak. This is a 12 Nm base: raise it in small steps with a hand on the stick. Until polarity has been measured it is capped at 10% whatever this says." />
                            <TextBlock x:Name="LockoutSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                            <styles:SHButtonSecondary Click="OnResetForces" Content="Reset forces to defaults"
                                                      Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"
                                       Text="Puts every dial on this tab back to its shipped value. Geometry, effects and the measured polarity are left alone." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="GATE WALLS" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="Every wall is a percentage of full force, so 90% is a wall you cannot push through by hand. These are the same kind of force as the lockout, which is why they can be made properly solid." />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                       Text="This shows the wall you feel pushing back if you drift away from centre without lining up on a column: nothing at all for a short free stretch, then a quick ramp up to a wall you cannot push through by hand once past it. Line up with a column instead and this wall gets out of the way entirely - blocking everywhere except where a gear actually is is the whole job of the gate." />
                            <local:GateWallCurveVisualizer x:Name="GateWallCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                            Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" />

                            <CheckBox x:Name="GeometryPercentToggle" Content="Show the lateral geometry dials below and under Advanced gate geometry as % of column spacing"
                                      Margin="0,0,0,4"
                                      Checked="OnGeometryPercentToggleChanged" Unchecked="OnGeometryPercentToggleChanged" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.6" Margin="0,0,0,8"
                                       Text="Column spacing genuinely differs by pattern - about 21845 counts on the four-column H6R/H7R, 32767 on the three-column H5R - so the same raw axis count is a different fraction of the room between columns depending which pattern a profile was tuned on. This only changes how the affected dials are displayed and edited here; it does not touch any stored value or rescale anything when the pattern is switched." />

                            <ui:TitledSlider Title="Gate wall, between columns (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="90"
                                             Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ChannelWallForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Slot wall / lateral rail (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="90"
                                             Value="{Binding ColumnPinForcePct, Mode=TwoWay}" />
                            <StackPanel Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                <ui:TitledSlider Title="Slot width, free corridor (axis counts)" Minimum="0" Maximum="2400"
                                                 TickFrequency="100" ShowResetButton="True" ResetValue="1100"
                                                 Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                                 Value="{Binding SlotHalfWidth, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Slot width, free corridor (% of column spacing)" Minimum="0" Maximum="12"
                                                 TickFrequency="0.5"
                                                 Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                                 Value="{Binding SlotHalfWidthPercent, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                           Text="A slot is a corridor with walls, not a pull toward its centre line. If a middle gear shakes while seated, widen this: a narrow corridor leaves the stick balanced on a point it can hunt around. The outer gears never shake because their wall only pushes one way, against the end of travel. Zero is the rail gate: the lever pulled straight onto the column line, like the native shifter mode - stable only with a moderate slot wall, so if a railed gear trembles, lower the wall force first." />
                            </StackPanel>
                            <ui:TitledSlider Title="Tunnel depth, free corridor (axis counts)" Minimum="0" Maximum="4000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ChannelFreeDepth, Mode=TwoWay}" />
                            <TextBlock x:Name="ChannelFreeDepthSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                       Text="The fore/aft twin of the slot width: how deep the tunnel stays free before its centring force begins. Zero closes the last free space in the gate, so the lever is guided on exactly one axis everywhere - together with zero slot width this is the native shifter-mode topology. Values above the neutral channel enter band are capped to it." />
                            <ui:TitledSlider Title="Fore/aft drag while on a column (%)" Minimum="0" Maximum="40"
                                             TickFrequency="1" ShowResetButton="True" ResetValue="5"
                                             Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ChannelGuideForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Wall bite distance (axis counts)" Minimum="60" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="600"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding WallRamp, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Wall bite distance (% of column spacing)" Minimum="0" Maximum="30"
                                             TickFrequency="0.5"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding WallRampPercent, Mode=TwoWay}" />
                            <TextBlock x:Name="WallRampSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" />
                            <ui:TitledSlider Title="Wall attack (ms to full force, 0 = off)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="0"
                                             Value="{Binding WallAttackMs, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Rebound absorption (%)" Minimum="0" Maximum="80" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="45"
                                             Value="{Binding WallYieldPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Wall friction (%)" Minimum="0" Maximum="40" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="15"
                                             Value="{Binding WallFrictionPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Damping (%)" Minimum="0" Maximum="80" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding DampingPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="A wall is flat past its bite, so the bite is where all trouble lives. Too short and it is a step - contact kicks, and a light press vibrates against it; too long and the wall goes spongy and can buzz. Raise the bite until the vibration stops, and no further. Wall attack is a second dial in time instead of space: force builds over these milliseconds on contact, releases instantly, and freezes while you press and hold still. Try 10-25 if short bites kick or corners hammer. Rebound absorption drains what a bounce returns. Wall friction is the gate surfaces' own grip - a share of whatever force you are pressed against, zero in free travel, so it costs no lightness; for lean-flutter the effective fix is MOZA Cockpit's Damper at ~15% (zero-latency, at the servo), with this dial as the software-side supplement. Damping here thickens the lever everywhere and is the last resort. The attack shapes walls only - the lockout, humps and detents stay sharp so speed cannot slip past them." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SEQUENTIAL STROKE" ShowSeparator="True"
                                      Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Actuation throw from centre (axis counts)" Minimum="4000" Maximum="30000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="28767"
                                             Value="{Binding SeqThrow, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Shift click kick (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="60"
                                             Value="{Binding SeqClickPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Stroke past the click (axis counts)" Minimum="500" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2500"
                                             Value="{Binding SeqOvertravel, Mode=TwoWay}" />
                            <ui:TitledSlider Title="End-stop wall (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="90"
                                             Value="{Binding SeqStopForcePct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The whole stroke, in order: centre to the firing point (the actuation throw - shorten it for a quicker shift; it moves the re-arm point with it), this much landing past the click, then the end-stop wall rising over the wall bite. The stop is measured from the firing point, so shortening the throw moves everything together. The click kick is a 25 ms burst in the stroke's direction the instant the shift registers - the mechanism letting go - which then throws the lever onto the end-stop: the two together are the thunk, so raise the kick for a harder click and the end-stop wall for a harder landing. Everything stays a wall toward centre, never a pocket: release the lever anywhere and it still comes home. Resistance up to the click is the detent resist dial; what remains after it is detent hold, which is also the spring that brings the lever back." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLOT MOUTHS" ShowSeparator="True"
                                      Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="The ends of the dividers between slots, where they meet the neutral tunnel. Square is the plain rectangular notch the gate has always had. The other two open the slot out toward the tunnel, which a hand reads as an eased or a chamfered edge - they only ever remove force, never add it, so the shaping guides rather than shoves." />

                            <TextBlock Text="Mouth shape" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding MouthShapeIndex, Mode=TwoWay}" Margin="0,0,0,8"
                                      HorizontalAlignment="Left" MinWidth="240">
                                <ComboBoxItem Content="Square - a plain notch (default)" />
                                <ComboBoxItem Content="Rounded - filleted on both sides" />
                                <ComboBoxItem Content="Angled - chamfered toward the next gear" />
                            </ComboBox>

                            <ui:TitledSlider Title="Mouth reach down the slot (axis counts)" Minimum="1000" Maximum="12000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="5000"
                                             Value="{Binding MouthDepth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Mouth opening (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="100"
                                             Value="{Binding MouthOpenPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Reach is what decides whether the shaping is felt at all. The base takes three to four milliseconds to answer, in which a lever being shifted covers fifteen hundred counts or more - so shaping confined to a shorter stretch than that is over before a single corrected force arrives. Several thousand counts spans the whole withdrawal stroke. Opening is a share of what the geometry safely allows, so it can never reach the next column's slot or the lockout's band. Angled opens one side only, toward the next gear in sequence, and does nothing at all where there is no next gear or where the crossing is the lockout." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLIDING ACROSS THE GATE" ShowSeparator="True"
                                      Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="What the hand feels moving along the neutral channel: a light pull into each column, a hump to climb between the ordinary columns, and the lockout gate before 7/R - a one-way fight, flat toward the main gears across a compact band, so a fast flick pays the same price as a slow push. Leaving 7/R is assisted, like a real range gate. Its width times its force is the toll: if slams still get through, widen or strengthen it. The graph below shows this across the whole width of the gate, coloured band and all; the white dot tracks where the stick actually is while sliding." />
                            <local:SlidingAcrossGateVisualizer x:Name="SlidingAcrossGateCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <ui:TitledSlider Title="Lockout gate, guarding the R column (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="70"
                                             Visibility="{Binding HasLockout, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding LockoutForcePct, Mode=TwoWay}" />
                            <StackPanel Visibility="{Binding HasLockout, Converter={StaticResource BoolToVis}}">
                                <ui:TitledSlider Title="Lockout gate half-width (axis counts)" Minimum="500" Maximum="6000"
                                                 TickFrequency="100" ShowResetButton="True" ResetValue="2200"
                                                 Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                                 Value="{Binding LockoutHalfWidth, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Lockout gate half-width (% of column spacing)" Minimum="0" Maximum="30"
                                                 TickFrequency="0.5"
                                                 Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                                 Value="{Binding LockoutHalfWidthPercent, Mode=TwoWay}" />
                            </StackPanel>
                            <ui:TitledSlider Title="Humps between the other columns (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="15"
                                             Value="{Binding BarrierForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Hump width (axis counts)" Minimum="400" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2500"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding BarrierWidth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Hump width (% of column spacing)" Minimum="0" Maximum="40"
                                             TickFrequency="1"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding BarrierWidthPercent, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Pull into a column (%)" Minimum="0" Maximum="60"
                                             TickFrequency="1" ShowResetButton="True" ResetValue="12"
                                             Value="{Binding ColumnDetentForcePct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Neutral spring toward 3/4 (%)" Minimum="0" Maximum="60"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="0"
                                             Value="{Binding HomeSpringPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="Off at zero. A real H lever rests at the 3/4 gate: this pulls the lever there whenever it is in the neutral channel, fading out with depth so a held gear feels no side pull. Around 25-30% it out-pulls the default column detent and humps and a released lever walks home from anywhere in the channel; below that it is a lean rather than a return. It follows the gear layout, so mirrored columns move home with the gears. If the lever trembles parked at 3/4, lower it - like every pull toward a place, it is only stable in moderation." />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The pull into a column is light while you slide along the channel and rises in one straight line to the full slot wall by the time you have left it, so the same dial also sets how firmly an entry taken slightly off a column is steered onto its slot. There is no force at all across a column's own width, so it guides without giving the lever a centre line to hunt around. It has no separate funnel strength: a second waypoint would either make one leg steeper than the walls or land exactly on this line." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="SLOT DETENT" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="This is what makes a gear feel like it clicks into place, the way a real gearbox does - not just friction holding the lever, but a shaped force that changes three times on the way in. Push toward a gear and it resists at first, like pushing into a spring. Keep pushing past that resistance and the lever gets pulled the rest of the way in on its own - the snick, the same moment a synchro drops into place in a real box. Once seated, a steady hold keeps the gear from slipping back out, even against a base that is still trying to nudge the stick back to centre. The white dot on the graph below tracks exactly where in that sequence the stick currently is." />
                            <local:DetentCurveVisualizer x:Name="DetentCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <ui:TitledSlider Title="Resistance entering the slot (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="22"
                                             Value="{Binding DetentResistPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Pull into the slot, the snick (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="35"
                                             Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding DetentPullPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Seated hold, keeps the gear in (%)" Minimum="0" Maximum="100"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="55"
                                             Value="{Binding DetentHoldPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The seated hold has to beat whatever the base does by itself. A base that is still self-centring pulls hard at full deflection, and a light hold loses to it - the gear simply falls back out." />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- =========================== EFFECTS ============================ -->
        <styles:SHTabItem x:Name="EffectsTab" Header="Effects">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="TELEMETRY EFFECTS" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                       Text="Vibration driven by the game, played through the lever on top of the gate. Every effect is a zero-mean buzz - it can make the lever tremble but never push it anywhere - and all of them fall silent within half a second of the game pausing or closing. Volumes are shares of a fixed vibration budget scaled by the overall gain, so the gate always keeps its authority above them. Everything here is off by default." />
                            <styles:SHButtonSecondary Click="OnResetEffects" Content="Reset effects to defaults"
                                                      Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="GEAR GRIND ON A DROPPED CLUTCH" ShowSeparator="True"
                                      Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding GrindEnabled, Mode=TwoWay}"
                                                     Content="Grind when shifting without the clutch" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,8"
                                       Text="Push into a gear with the clutch up while the engine is turning and the box grinds: a harsh, uneven rattle up the lever. With rejection on, the gear also refuses to go in - the slot loses its snick and its hold and only pushes back, like a blocking synchro ring - and pressing the clutch mid-push lets it thunk straight home. Needs a game that reports the clutch pedal; an engaged gear never grinds, and sequential is exempt because dog boxes shift clutchless by design." />
                            <styles:SHToggleCheckbox IsChecked="{Binding GrindRejectsGear, Mode=TwoWay}"
                                                     Content="Reject the gear while grinding (registers only once the clutch is down)"
                                                     Margin="0,0,0,6" />
                            <ui:TitledSlider Title="Grind volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="60"
                                             Value="{Binding GrindGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Grind frequency (Hz)" Minimum="15" Maximum="90" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="33"
                                             Value="{Binding GrindFreqHz, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Balk wall (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="70"
                                             Value="{Binding GrindWallPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Clutch counts as pressed above (%)" Minimum="5" Maximum="90"
                                             TickFrequency="5" ShowResetButton="True" ResetValue="25"
                                             Value="{Binding GrindClutchThresholdPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Only grind above (km/h)" Minimum="0" Maximum="40" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="0"
                                             Value="{Binding GrindMinSpeedKmh, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="The balk wall is the border a rejected shift meets: it stacks on the slot's entry resistance and stays, so the lever grinds against something solid instead of a light lean - and the grind gets louder the harder you force it. It only acts while rejection is balking the gear; zero leaves just the resistance. Raise the speed floor if garage or pit-lane shuffling grinds when you would rather it stayed quiet. SimHub reports pedals as 0-100; if your game's clutch never crosses the threshold, watch the Clutch property in SimHub and set the threshold below what a pressed pedal reads." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="ENGINE VIBRATION" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxEngineEnabled, Mode=TwoWay}"
                                                     Content="Engine vibration - pitch follows the revs" Margin="0,0,0,6" />
                            <ui:TitledSlider Title="Volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="25"
                                             Value="{Binding FxEngineGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Frequency at 1000 rpm (Hz)" Minimum="5" Maximum="60"
                                             TickFrequency="1" ShowResetButton="True" ResetValue="17"
                                             Value="{Binding FxEngineFreqAt1000Rpm, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="A constant tremble whose pitch scales with the revs: at 2000 rpm it is twice this, at 3000 three times, capped at 130 Hz where the base stops rendering pitch cleanly. Set it by what idle should feel like - an 850 rpm idle at the default 17 buzzes at about 14 Hz, a slow thud; 34 is a four-cylinder's firing pulses. Keep the volume low: it plays whenever the engine turns." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="REV LIMITER" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxLimiterEnabled, Mode=TwoWay}"
                                                     Content="Buzz on the rev limiter" Margin="0,0,0,6" />
                            <ui:TitledSlider Title="Volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="45"
                                             Value="{Binding FxLimiterGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="55"
                                             Value="{Binding FxLimiterFreqHz, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Starts at (% of redline)" Minimum="80" Maximum="100" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="96"
                                             Value="{Binding FxLimiterFromPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="A hard buzz once the revs pass the threshold, meant to be felt through a hand already on the lever rather than heard. Keep it well above the engine vibration's frequency so the two are distinguishable when they overlap. It needs the game to report a redline: where none is reported the effect stays silent, however this is set." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="ABS AND TRACTION CONTROL" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxAbsEnabled, Mode=TwoWay}"
                                                     Content="Buzz while ABS is pulsing" Margin="0,0,0,6" />
                            <ui:TitledSlider Title="ABS volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="40"
                                             Value="{Binding FxAbsGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="ABS frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="44"
                                             Value="{Binding FxAbsFreqHz, Mode=TwoWay}" />
                            <styles:SHToggleCheckbox IsChecked="{Binding FxTcEnabled, Mode=TwoWay}"
                                                     Content="Buzz while traction control cuts in" Margin="0,8,0,6" />
                            <ui:TitledSlider Title="TC volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="35"
                                             Value="{Binding FxTcGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="TC frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="60"
                                             Value="{Binding FxTcFreqHz, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Driven by the game's own ABS-active and TC-active flags. Different frequencies keep the two distinguishable when both fire in the same corner." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="CURBS AND BUMPS" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxCurbsEnabled, Mode=TwoWay}"
                                                     Content="Rattle over curbs and bumps" Margin="0,0,0,6" />
                            <ui:TitledSlider Title="Volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="45"
                                             Value="{Binding FxCurbsGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="40"
                                             Value="{Binding FxCurbsFreqHz, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Full volume at (G of vertical shake)" Minimum="0.2" Maximum="3"
                                             TickFrequency="0.1" ShowResetButton="True" ResetValue="1"
                                             Value="{Binding FxCurbsFullAtG, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Read out of the car's vertical acceleration, so it works in any game that reports it, with no surface data needed: a curb is a rapid shake in heave, which sustained cornering or braking load is not - a baseline tracker follows the slow part and only the shake plays, with a short ring-down that keeps a rumble strip's rhythm. Lower the full-volume G to make gentle curbs louder. Games that report no acceleration stay silent here; for per-wheel fidelity, drive the custom property below from a ShakeIt road-impacts group instead." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="GEAR SHIFT PULSE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxShiftEnabled, Mode=TwoWay}"
                                                     Content="Pulse when the game's gear changes" Margin="0,0,0,6" />
                            <ui:TitledSlider Title="Volume (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="45"
                                             Value="{Binding FxShiftGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="44"
                                             Value="{Binding FxShiftFreqHz, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Pulse length (ms)" Minimum="20" Maximum="300" TickFrequency="10"
                                             ShowResetButton="True" ResetValue="80"
                                             Value="{Binding FxShiftDurationMs, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Fires on the game's own gear telemetry, not on this plugin's gate - so it confirms what the game actually accepted, which is useful in sequential mode and with a paddle car." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="CUSTOM PROPERTY" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <styles:SHToggleCheckbox IsChecked="{Binding FxCustomEnabled, Mode=TwoWay}"
                                                     Content="Volume follows a SimHub property" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Property" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding FxCustomProperty, Mode=TwoWay}" Width="380" />
                            </StackPanel>
                            <ui:TitledSlider Title="Volume at 100 (%)" Minimum="0" Maximum="100" TickFrequency="5"
                                             ShowResetButton="True" ResetValue="30"
                                             Value="{Binding FxCustomGainPct, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Frequency (Hz)" Minimum="15" Maximum="120" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="44"
                                             Value="{Binding FxCustomFreqHz, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Any SimHub property scaled 0-100 drives this effect's volume - try DataCorePlugin.GameData.Throttle to hear it work. The real use is ShakeIt: enable 'Export property' on a Bass Shakers effect group and type its exported property name here, which puts SimHub's whole effects engine - road rumble, wheel slip, impacts - at the lever's disposal, with all of ShakeIt's own tuning." />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- =========================== GEOMETRY =========================== -->

        <styles:SHTabItem x:Name="GeometryTab" Header="Geometry">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <styles:SHSection Title="FORCE SHAPING" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <ui:TitledSlider Title="Gate wall fade width, across a column (axis counts)" Minimum="200" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="1500"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding WallBlend, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Gate wall fade width, across a column (% of column spacing)" Minimum="0" Maximum="30"
                                             TickFrequency="0.5"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding WallBlendPercent, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="How far sideways it takes the fore/aft gate wall to go from open, on a column, to solid between columns. This is the mouth of each slot seen from the tunnel: narrow and the gate snaps shut as you leave a column, wide and every entry feels vague. It is a sideways gradient, so it is also what corners are made of - widen it if corners feel harsh." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="The lateral guide has no ramp of its own any more. Every sideways force in the gate - the pull along the tunnel, the funnel into a slot, the slot wall itself - now rises at the same stiffness as the wall, so a gentler force gets a shorter face instead of a steeper one. Its own ramp was a free parameter, and at the bottom of its range it made the funnel the steepest thing in the gate, three and a half times the wall face, in exactly the place the lever crosses on every shift." />

                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                       Text="The lockout gate places itself: it sits just outside the band of the last main-section column, so sliding across the gate meets it straight away instead of after a long stretch of dead travel. Its width is on the Feel tab, and the Monitor tab draws the band where it actually is." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHExpander Header="Advanced gate geometry">
                        <StackPanel Margin="0,8,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="All in axis counts: positions run 0 to 65535 with 32767 at centre, so 1000 counts is about a finger's width of stick travel. These decide where the gate thinks the lever is, not what it feels like - change them only if gear detection is wrong, and use the Feel tab for anything about strength." />

                            <ui:TitledSlider Title="Neutral tunnel half-depth (enter)" Minimum="200" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Value="{Binding ChannelHalfEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Neutral tunnel half-depth (leave)" Minimum="200" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="5200"
                                             Value="{Binding ChannelHalfExit, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="How far fore or aft of centre still counts as the neutral tunnel. This is a genuine hysteresis pair - the lever has to travel past the larger figure to be considered out of neutral, and come back inside the smaller one to be back in it, so resting on the boundary cannot flutter the gear. The gap between them is also the distance over which the slot walls fade in as you leave the tunnel, so widening it makes the handover gentler." />
                            <ui:TitledSlider Title="Outer column half-width" Minimum="500" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2600"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding ColumnEdgeEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Outer column half-width (% of column spacing)" Minimum="0" Maximum="50"
                                             TickFrequency="1"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ColumnEdgeEnterPercent, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Inner column half-width" Minimum="300" Maximum="8000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="1200"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding ColumnInnerHalfEnter, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Inner column half-width (% of column spacing)" Minimum="0" Maximum="40"
                                             TickFrequency="1"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ColumnInnerHalfEnterPercent, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Lockout clearance from the last column" Minimum="300" Maximum="10000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="2400"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding ColumnInnerHalfExit, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Lockout clearance from the last column (% of column spacing)" Minimum="0" Maximum="50"
                                             TickFrequency="1"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding ColumnInnerHalfExitPercent, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="How wide each column's territory is, measured either side of its centre line - the outer two get more because they run to the end of travel. There is no matching release width: once the lever is in a gear the only way out is back through the tunnel, at any sideways distance whatever. The last figure is the room the lockout gate leaves beside the 5/6 column before its band begins." />
                            <ui:TitledSlider Title="Engage depth (from the end of travel)" Minimum="500" Maximum="28000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="4000"
                                             Value="{Binding EngageDepth, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Release depth (from the end of travel)" Minimum="1000" Maximum="30000"
                                             TickFrequency="500" ShowResetButton="True" ResetValue="8000"
                                             Value="{Binding ReleaseDepth, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="Both measure from the ends of travel, so raising them shortens the throw - centre is 32767, and the shift fires once the lever is within the engage depth of a stop. This is also the sequential lever's activation distance: its spring reaches full resistance exactly at the threshold and the click moves with it, so a short throw stays progressive. Keep the release depth 2000-4000 above the engage depth or the re-arm point sits on top of the firing point." />
                            <ui:TitledSlider Title="Column handover width" Minimum="0" Maximum="6000"
                                             TickFrequency="100" ShowResetButton="True" ResetValue="400"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}"
                                             Value="{Binding DetentHysteresis, Mode=TwoWay}" />
                            <ui:TitledSlider Title="Column handover width (% of column spacing)" Minimum="0" Maximum="30"
                                             TickFrequency="0.5"
                                             Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}"
                                             Value="{Binding DetentHysteresisPercent, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                       Text="Nothing to do with the slot detents. Sliding along the tunnel, the sideways pull has to change which column it belongs to at some point, and that swap is a reversal of a force: this is how far either side of the boundary the pull is faded out so the change cannot arrive as a step. It is deliberately small - the whole width is dead space with no sideways guidance, so a wide setting leaves the lever unguided across half the gate." />
                            <ui:TitledSlider Title="Ticks required to engage" Minimum="1" Maximum="20" TickFrequency="1"
                                             ShowResetButton="True" ResetValue="2"
                                             Value="{Binding MinEngageTicks, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="How many consecutive loop ticks the lever must sit past the engage depth before the gear registers, so a single stray reading cannot fire a shift. Ticks are loop rate below, so at the default 1000 Hz two ticks is two milliseconds - raise it only if gears register spuriously, because every tick added is delay a hand can feel." />
                        </StackPanel>
                    </styles:SHExpander>

                    <styles:SHExpander Header="Device and output">
                        <StackPanel Margin="0,8,0,8">
                            <ui:TitledSlider Title="FFB loop rate (Hz)" Minimum="100" Maximum="1000" TickFrequency="50"
                                             ShowResetButton="True" ResetValue="1000"
                                             Value="{Binding TickHz, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                                       Text="How often the gate is recomputed. Leave it at 1000: the base is the slow part of the loop, not this, so lowering it buys nothing and makes every wall arrive later. It is here to diagnose a struggling PC, not to tune feel. Which vJoy device carries the gears, and the base's vendor and product ids, are on the Setup tab." />
                        </StackPanel>
                    </styles:SHExpander>

                    <styles:SHSection Title="RESET" ShowSeparator="True">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <styles:SHButtonSecondary Click="OnResetGeometry" Content="Reset geometry"
                                                      Padding="12,4" Margin="0,0,8,0" />
                            <styles:SHButtonSecondary Click="OnResetEverything" Content="Reset everything"
                                                      Padding="12,4" />
                        </StackPanel>
                    </styles:SHSection>

                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

        <!-- =========================== MONITOR ============================ -->
        <styles:SHTabItem x:Name="MonitorTab" Header="Monitor">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <styles:SHSection Title="LIVE GATE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <local:GateVisualizer x:Name="Visualizer" Height="300" HorizontalAlignment="Left" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"
                                       Text="The dot is the stick. The shaded band on the right is the lockout: in the neutral channel it pushes back toward the main gears until you push through into 7/R." />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="READINGS" ShowSeparator="True">
                        <StackPanel x:Name="ReadingsPanel" Margin="0,4,0,8">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding AxisText}" Margin="0,2" />
                            <TextBlock Text="{Binding StateText}" Margin="0,2" />
                            <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="RECORD A TRACE" ShowSeparator="True">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8"
                                       Text="Records every tick - position, speed and the exact force sent to the base - so a movement that feels wrong can be replayed and measured instead of described. Press record, make the movement that misbehaves, press stop, and tell me what you did. Two minutes maximum, then it stops on its own." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <styles:SHButtonPrimary x:Name="RecordButton" Click="OnToggleRecord"
                                                        Content="Start recording" Margin="0,0,8,0" Padding="14,4" />
                                <styles:SHButtonSecondary x:Name="OpenTracesButton" Click="OnOpenTraces"
                                                          Content="Open trace folder" Padding="14,4" />
                            </StackPanel>

                            <TextBlock x:Name="RecordStatus" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </styles:SHSection>
                </StackPanel>
            </ScrollViewer>
        </styles:SHTabItem>

    </styles:SHTabControl>
</UserControl>
