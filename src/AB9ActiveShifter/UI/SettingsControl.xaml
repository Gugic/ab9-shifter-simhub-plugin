<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AB9ActiveShifter.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AB9ActiveShifter.UI.SettingsControl" mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="TuningSettingCard" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="#0C000000" />
            <Setter Property="BorderBrush" Value="#44505C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <DataTemplate x:Key="OutputRoleMappingTemplate">
            <Grid Margin="0,3" MaxWidth="650" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" MinWidth="180" IsEditable="True" ItemsSource="{Binding AvailableRoles}" Text="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Choose or type an existing Control Mapper role. Leave blank to send nothing." />
            </Grid>
        </DataTemplate>
        <Style TargetType="{x:Type ui:TitledSlider}">
            <Setter Property="ToolTip" Value="Right-click to undo the last adjustment." />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSliderGestureStartMouse" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSliderGestureEndMouse" />
            <EventSetter Event="PreviewKeyDown" Handler="OnSliderGestureStartKey" />
            <EventSetter Event="PreviewKeyUp" Handler="OnSliderGestureEndKey" />
        </Style>
        <Style TargetType="{x:Type local:ScaledTitledSlider}" BasedOn="{StaticResource {x:Type ui:TitledSlider}}" x:Key="ScaledTuningSlider">
            <Setter Value="SemiBold" Property="FontWeight" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Margin="8,8,8,4" Padding="12,8" Background="#22FFFFFF" CornerRadius="3">
            <WrapPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" FontWeight="SemiBold" Margin="0,4,16,4" />
                <styles:SHButtonSecondary x:Name="BannerInstallButton" Content="Install update" Click="OnInstallUpdate" Padding="10,4" Margin="0,2,6,2" />
                <styles:SHButtonSecondary Content="Open release notes" Click="OnOpenReleaseNotes" Padding="10,4" Margin="0,2,6,2" />
                <styles:SHButtonSecondary Content="Dismiss" Click="OnDismissUpdate" Padding="10,4" Margin="0,2,0,2" />
            </WrapPanel>
        </Border>
        <styles:SHTabControl Grid.Row="1" x:Name="WorkspaceTabs">
            <styles:SHTabItem Header="Main" x:Name="MainTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="MainWorkspaceGrid" Margin="16" SizeChanged="OnMainWorkspaceSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="0,0,0,12" Margin="0,0,0,16" BorderThickness="0,0,0,1" BorderBrush="#44505C" Grid.ColumnSpan="2">
                            <StackPanel x:Name="StatusPanel" Margin="0,4,0,8">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" x:Name="MainModeText" />
                                <TextBlock x:Name="MainBaseConnectionWarning" TextWrapping="Wrap" Foreground="#F0B35A" Margin="0,0,0,8" Visibility="Collapsed" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <UniformGrid Columns="2">
                                    <TextBlock Text="{Binding DeviceText}" Margin="0,2" />
                                    <TextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Margin="0,2" />
                                    <TextBlock Text="{Binding GearText}" Margin="0,2" />
                                    <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                                </UniformGrid>
                                <styles:SHButtonSecondary Content="Device, output and options" Click="OnOpenOptions" Padding="14,6" Margin="0,4,8,4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="MainProfilePanel" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <Border x:Name="ProfileSection" Padding="0,0,0,4">
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Profile and pattern" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="ProfileCombo" Margin="0" IsEditable="True" SelectionChanged="OnProfileSelected" HorizontalAlignment="Stretch" Grid.Column="1" />
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,12">
                                        <styles:SHButtonSecondary Click="OnAddProfile" Content="Duplicate" Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary x:Name="RenameProfileButton" Click="OnRenameProfile" Content="Rename" Padding="8,3" Margin="0,4,6,0" ToolTip="Type a new name in the profile box, then click Rename." />
                                        <styles:SHButtonSecondary x:Name="DeleteProfileButton" Click="OnDeleteProfile" Content="Delete" Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary Click="OnExportProfile" Content="Export..." Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary Click="OnImportProfile" Content="Import..." Padding="8,3" Margin="0,4,6,0" />
                                    </WrapPanel>
                                    <TextBlock x:Name="PresetNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" Visibility="Collapsed" Text="Shipped preset. Changing a dial creates an editable copy; the preset stays available as a starting point." />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox SelectedIndex="{Binding PatternIndex, Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="H pattern, 7 gears + R (lockout)" />
                                            <ComboBoxItem Content="H pattern, 6 gears + R (no 7th slot)" />
                                            <ComboBoxItem Content="H pattern, 5 gears + R" />
                                            <ComboBoxItem Content="Sequential (+ / -)" />
                                            <ComboBoxItem Content="Automatic (P R N D)" />
                                            <ComboBoxItem Content="H pattern, 6 gears, no reverse (truck)" />
                                            <ComboBoxItem Content="Handbrake (analog)" />
                                        </ComboBox>
                                    </Grid>
                                    <ui:TitledSlider x:Name="VirtualSequentialPulse" Title="Sequential pulse length (ms)" Minimum="20" Maximum="400" TickFrequency="10" ShowResetButton="True" ResetValue="120" Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}" Value="{Binding SeqPulseMs, Mode=TwoWay}" Margin="0,4,0,8" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,0,0,8">
                                <Border x:Name="VirtualEnableSection" Margin="0,4,0,4" Padding="0">
                                    <StackPanel Margin="0">
                                        <styles:SHToggleCheckbox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="Shifter enabled" Margin="0" ToolTip="Master switch for the base and selected gear output. Off clears buttons and releases both devices." />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VirtualFreeStickSection" Margin="0,4,0,4" Padding="0">
                                    <StackPanel Margin="0">
                                        <styles:SHToggleCheckbox IsChecked="{Binding FreeStick, Mode=TwoWay}" Content="Release all forces (free stick)" Margin="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,12" x:Name="TuningButtons">
                                <styles:SHButtonSecondary Content="Geometry…" Click="OnOpenGeometry" Padding="14,6" Margin="0,0,8,0" x:Name="OpenGeometryButton" />
                                <styles:SHButtonSecondary Content="Feel…" Click="OnOpenFeel" Padding="14,6" Margin="0,0,8,0" x:Name="OpenFeelButton" />
                                <styles:SHButtonSecondary Content="Effects…" Click="OnOpenEffects" Padding="14,6" Margin="0,0,8,0" x:Name="OpenEffectsButton" />
                            </WrapPanel>
                            <styles:SHExpander Header="Automatic profile switching" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="Use this profile when the game changes to a matching vehicle. Enter one vehicle ID per line, or leave empty to select profiles manually." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                                    <TextBox x:Name="CarModelsBox" AcceptsReturn="True" Height="82" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnCarModelsChanged" ToolTip="Use the vehicle ID reported by DataCorePlugin.GameData.CarModel in SimHub’s available properties. The first matching profile in the list wins." />
                                    <WrapPanel Margin="0,6,0,4">
                                        <styles:SHButtonSecondary x:Name="AddLastCarButton" Click="OnAddLastCarModel" Content="Add last vehicle" Padding="8,3" Margin="0,0,6,4" />
                                        <styles:SHButtonSecondary Click="OnAddBlankCarModelLine" Content="Add manually" Padding="8,3" ToolTip="Adds a blank line to the box above so you can type an id by hand" Margin="0,0,6,4" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LastCarModelText" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
                                </StackPanel>
                            </styles:SHExpander>
                            <styles:SHExpander Header="Sharing and button mapping" Margin="0,0,0,8">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Duplicate creates an editable copy. Export shares the tune; Import adds a new profile with forces off and keeps this rig’s device settings and calibration." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                                    <TextBlock x:Name="OutputBindingSummary" TextWrapping="Wrap" Opacity="0.8" Margin="0" />
                                </StackPanel>
                            </styles:SHExpander>
                        </StackPanel>
                        <Border x:Name="MainLivePanel" Grid.Row="1" Grid.Column="1" Padding="12" Background="#0C000000" CornerRadius="4" VerticalAlignment="Top">
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="Live gate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <local:GateVisualizer x:Name="Visualizer" Height="340" HorizontalAlignment="Stretch" />
                                <styles:SHExpander Header="Reading the live monitor" Margin="0,4,0,8">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="The dot is the stick, and the shaded area is the gate's free space - drawn at the size the geometry actually makes it, so every dial on Geometry moves something here. The orange band is the lockout: in the neutral channel it pushes back toward the paying side until you push through - or, in a hard mode, until the release key opens it, and the band dims while released." />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="Blue marks are what the plugin measures rather than what the hand feels: the solid lines across each slot are the engage depth, where the gear registers, and the dashed ones the release depth, where it lets go. The blue brackets on the tunnel edge are how wide each column's doorway opens, and the dashed blue pairs in the tunnel are the column handover width. The faint dashed verticals are the ownership boundaries - past one of those, a push that beats the wall lands in the next column's slot." />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" x:Name="MainRecordStatus" />
                            <styles:SHExpander Header="Using the master switch and free stick" Margin="0,4,0,8">
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="Shifter enabled controls the base and selected gear output together. While enabled, the plugin keeps its output acquired through base disconnects and restarts. Buttons clear while the base is unavailable, then follow its position on reconnect. Turning this off clears buttons and releases both devices. Moza AB9 native H-Pattern mode releases plugin output too." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="This is a 12 Nm base and this is third-party software driving it: if the lever ever shakes, kicks or drives itself to a stop, untick this - and if it will not stop, cut the base's power. Keep your face and free hand clear the first time you enable a profile you have not felt before. See ABOUT in Options." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="Releases the plugin’s forces while keeping its device connection. Onboard base effects can still resist movement in Moza AB9 mode." />
                                </StackPanel>
                            </styles:SHExpander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </styles:SHTabItem>
            <styles:SHTabItem Header="Options" x:Name="OptionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <StackPanel x:Name="SetupIntro">
                            <TextBlock Text="Set up your shifter" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a mode, prepare the base, select the output and measure polarity. Once complete, Main becomes the everyday workspace." TextWrapping="Wrap" Margin="0,4,0,8" />
                        </StackPanel>
                        <styles:SHSection Title="OPERATING MODE" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <ComboBox Width="360" HorizontalAlignment="Left" SelectionChanged="OnOperatingModeSelected" Margin="0,4,0,8" x:Name="OperatingModeCombo">
                                    <ComboBoxItem Content="Moza AB9" Tag="Ab9Native" />
                                    <ComboBoxItem Content="Generic FFB stick" Tag="GenericFfbStick" />
                                    <ComboBoxItem Content="Moza AB9 native H-Pattern" Tag="Ab9HPattern" />
                                </ComboBox>
                                <styles:SHExpander Header="What does this mean?" IsExpanded="False" Margin="0,0,0,8">
                                    <StackPanel Margin="0,6,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="•" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8">
                                                <Run FontWeight="SemiBold" Text="Moza AB9" /> — Uses internal AB9 base settings alongside the plugin's virtual shifter.</TextBlock>
                                            <TextBlock Grid.Row="1" Text="•" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8">
                                                <Run FontWeight="SemiBold" Text="Generic FFB stick" /> — Uses DirectInput only. Choose this for a base other than the AB9 and follow the manual checklist.</TextBlock>
                                            <TextBlock Grid.Row="2" Text="•" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="Moza AB9 native H-Pattern" /> — Uses the firmware shifter configured in Moza Pit House / AZOM. Plugin output is disabled.</TextBlock>
                                        </Grid>
                                        <TextBlock Text="You can choose any mode with the base connected or disconnected and the master switch on or off." TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" />
                                    </StackPanel>
                                </styles:SHExpander>
                                <TextBlock x:Name="BaseConnectionWarning" TextWrapping="Wrap" Foreground="#F0B35A" Margin="0,0,0,8" Visibility="Collapsed" />
                                <TextBlock x:Name="NativeStatusText" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <styles:SHButtonSecondary Content="Refresh base" Click="OnNativeRefresh" Padding="14,6" Margin="0,4,8,4" x:Name="NativeRefreshButton" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" x:Name="NativeOperationText" />
                                <TextBlock Text="Set up the firmware H-pattern shifter in Moza Pit House / AZOM. Plugin forces, profiles, gear output and effects are disabled in this mode. Choose another mode to return." TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,8" x:Name="HPatternNotice" />
                            </StackPanel>
                        </styles:SHSection>
                        <StackPanel x:Name="VirtualOptionsPanel">
                            <styles:SHExpander x:Name="PrepareGroup" Header="Prepare the base" Margin="0,8,0,8">
                                <styles:SHSection Title="" ShowSeparator="True" x:Name="PrepareSection">
                                    <StackPanel Margin="0,6,0,16">
                                        <StackPanel x:Name="Ab9PreparePanel" Visibility="Collapsed">
                                            <TextBlock Text="Prepare base checks the connected AB9, then:" TextWrapping="Wrap" Margin="0,4,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="•" />
                                                <TextBlock Grid.Column="1" Text="Selects flight mode." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Text="•" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Applies this profile's internal base settings." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Text="•" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Leaves plugin output off for setup." TextWrapping="Wrap" />
                                            </Grid>
                                            <styles:SHButtonSecondary Content="Prepare base" Click="OnPrepareSelectedMode" HorizontalAlignment="Left" Padding="14,6" Margin="0,8,0,4" x:Name="PrepareBaseButton" />
                                        </StackPanel>
                                        <styles:SHSection x:Name="VirtualChecklistSection" Title="BEFORE YOU START" ShowSeparator="True">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="1." FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="Select DirectInput force feedback in your base's settings app." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Text="2." FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Turn off built-in centring and other background effects." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Text="3." FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Close any application holding the base exclusively." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="3" Text="4." FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Choose vJoy (direct) or SimHub Control Mapper (native) below and configure its output." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="4" Text="5." FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Bind the output's buttons or keys in your game." TextWrapping="Wrap" />
                                            </Grid>
                                        </styles:SHSection>
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <styles:SHExpander x:Name="OutputGroup" Header="Base and output" Margin="0,8,0,8">
                                <styles:SHSection x:Name="VirtualOutputSection" Title="" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <Grid Margin="0,0,0,10" MaxWidth="650" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Output" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Width="330" HorizontalAlignment="Left" SelectedIndex="{Binding OutputModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="vJoy (direct)" />
                                                <ComboBoxItem Content="SimHub Control Mapper (native)" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel x:Name="VJoyPanel">
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="Device" VerticalAlignment="Center" Width="80" />
                                                <ComboBox x:Name="VJoyCombo" Width="330" Margin="0,0,8,0" SelectionChanged="OnVJoyDeviceSelected" />
                                                <styles:SHButtonSecondary Click="OnRefreshVJoyDevices" Content="Refresh" Padding="10,3" />
                                            </WrapPanel>
                                            <TextBlock x:Name="VJoyHint" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" Text="Choose a dedicated virtual device that carries gears into your game. Create or resize it in vJoyConf, then refresh. H patterns use up to 8 buttons, sequential uses 9–10, and PRND uses 11–14. If Control Mapper also uses vJoy, give it a different device." />
                                        </StackPanel>
                                        <StackPanel x:Name="ControlMapperPanel" Visibility="Collapsed">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Control Mapper is a separate SimHub feature from Controls and events. Enable it below if needed, configure its output and roles, then assign existing roles here. Control Mapper can send keyboard keys, vJoy or Arduino bridge buttons, or SimHub controls. This output choice is separate from the AB9 operating mode." />
                                            <TextBlock x:Name="ControlMapperStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <styles:SHButtonSecondary x:Name="EnableControlMapperButton" Content="Enable Control Mapper and restart SimHub" Click="OnEnableControlMapper" Padding="10,3" Margin="0,0,8,4" />
                                                <styles:SHButtonSecondary x:Name="ConfigureControlMapperButton" Content="Configure Control Mapper" Click="OnConfigureControlMapper" Padding="10,3" Margin="0,0,8,4" />
                                                <styles:SHButtonSecondary Content="Refresh roles" Click="OnRefreshControlMapperRoles" Padding="10,3" Margin="0,0,0,4" />
                                            </WrapPanel>
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Configure all patterns here without changing the active profile. These are rig settings; only the active pattern sends output." />
                                            <styles:SHSection Title="H-pattern mappings" ShowSeparator="True">
                                                <StackPanel Margin="0,4,0,12">
                                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Use Gear1, Gear2 and so on, and GearR for Reverse, or choose your own roles. Returning to neutral releases the held gear role. Leave H-pattern neutral (optional) blank unless your game needs a separate neutral key." />
                                                    <ItemsControl x:Name="HPatternMappings" ItemTemplate="{StaticResource OutputRoleMappingTemplate}" />
                                                </StackPanel>
                                            </styles:SHSection>
                                            <styles:SHSection Title="Sequential mappings" ShowSeparator="True">
                                                <StackPanel Margin="0,4,0,12">
                                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Use ShiftUp and ShiftDown, or choose your own roles. Each shift pulses its role using Sequential pulse length (ms) on Main." />
                                                    <ItemsControl x:Name="SequentialMappings" ItemTemplate="{StaticResource OutputRoleMappingTemplate}" />
                                                </StackPanel>
                                            </styles:SHSection>
                                            <styles:SHSection Title="PRND mappings" ShowSeparator="True">
                                                <StackPanel Margin="0,4,0,12">
                                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Assign existing roles to P, R, N and D. If you need additional roles, you can create custom ones such as PRND.P, PRND.R, PRND.N and PRND.D. The selected position holds its assigned role, including N." />
                                                    <ItemsControl x:Name="PrndMappings" ItemTemplate="{StaticResource OutputRoleMappingTemplate}" />
                                                </StackPanel>
                                            </styles:SHSection>
                                            <TextBlock x:Name="ControlMapperHint" TextWrapping="Wrap" Opacity="0.85" Margin="0,8,0,0" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" Text="H gears and PRND positions hold their roles; sequential shifts use the pulse length on Main. H-pattern neutral is optional. Blank mappings send nothing. Check direct-gear and neutral keyboard bindings in your game. These assignments belong to the rig and survive profile switches." />
                                        </StackPanel>
                                        <styles:SHExpander Header="Base device identity" Margin="0,8,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="The base is matched by USB vendor and product id, written in hex as Device Manager shows them. The AB9 is 346E / 1000; only change these if your base enumerates differently. This lives here rather than with the other advanced settings because a base that is not found is exactly the case where the tuning base is not yet ready." />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Vendor id" VerticalAlignment="Center" Width="80" />
                                                    <TextBox Text="{Binding VendorIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,16,0" />
                                                    <TextBlock Text="Product id" VerticalAlignment="Center" Width="80" />
                                                    <TextBox Text="{Binding ProductIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" />
                                                </StackPanel>
                                            </StackPanel>
                                        </styles:SHExpander>
                                        <styles:SHToggleCheckbox Content="Automatically retake the base" IsChecked="{Binding AutoRetakeBase, Mode=TwoWay}" Margin="0,12,0,4" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Retry the base connection if a game interrupts force feedback. On by default. Turn this off if retaking the base causes problems in a game; the plugin will then wait until no game is running. This setting applies to every profile." />
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <styles:SHExpander x:Name="HandbrakeCalibrationGroup" Header="Handbrake travel calibration" Margin="0,8,0,8" Visibility="{Binding IsHandbrake, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,8,0,8">
                                    <TextBlock TextWrapping="Wrap" Text="Enable free stick before capturing travel. With the plugin running, capture the released position, then your full pull. Either pull direction works; endpoints must be at least 8000 counts apart. This calibration is shared by all profiles. Enable the Z axis in vJoyConf and bind it as the game's handbrake." />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="Start Y" Width="95" VerticalAlignment="Center" />
                                        <TextBox Width="80" Text="{Binding HandbrakeRestY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <styles:SHButtonSecondary Content="Capture start" Tag="Rest" Click="OnCaptureHandbrakeEndpoint" Margin="8,0,0,0" Padding="10,3" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <TextBlock Text="End Y" Width="95" VerticalAlignment="Center" />
                                        <TextBox Width="80" Text="{Binding HandbrakeFullPullY, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <styles:SHButtonSecondary Content="Capture end" Tag="Full" Click="OnCaptureHandbrakeEndpoint" Margin="8,0,0,0" Padding="10,3" />
                                    </StackPanel>
                                    <TextBlock x:Name="HandbrakeCaptureHint" TextWrapping="Wrap" Opacity="0.85" />
                                </StackPanel>
                            </styles:SHExpander>
                            <styles:SHExpander x:Name="CalibrationGroup" Header="Polarity calibration" Margin="0,8,0,8">
                                <styles:SHSection x:Name="VirtualCalibrationSection" Title="" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <StackPanel x:Name="CalibrationDonePanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <TextBlock x:Name="CalibrationSummary" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
                                            <styles:SHButtonSecondary Click="OnRecalibrate" Content="Measure again" Padding="14,4" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel x:Name="CalibrationFullPanel">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Required in Moza AB9 and Generic FFB stick: the plugin drives the gate through DirectInput in both modes. Calibration checks push and spring direction on each axis. Incorrect polarity can push the stick toward its stops. Until confirmed, plugin gain stays capped at 10% and setup remains incomplete." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Calibration applies a short push each way and watches which way the stick actually moves, so it works even though the base holds itself centred. Take your hands off the stick and leave them off - anything resisting the stick will spoil the measurement. It takes about four seconds." />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <styles:SHButtonPrimary x:Name="CalibrateButton" Click="OnCalibrate" Content="Measure polarity" Margin="0,0,8,0" Padding="14,4" />
                                                <styles:SHButtonSecondary x:Name="CancelCalibrationButton" Click="OnCancelCalibration" Content="Cancel" Padding="14,4" />
                                            </StackPanel>
                                            <Border x:Name="CalibrationResultBorder" Padding="10,8" Margin="0,0,0,8" Background="#22FFFFFF" CornerRadius="3" Visibility="Collapsed">
                                                <StackPanel x:Name="CalibrationResultPanel" />
                                            </Border>
                                            <ui:TitledSlider Title="Calibration force (%)" Minimum="5" Maximum="60" TickFrequency="5" ShowResetButton="True" ResetValue="10" Value="{Binding CalibrationForcePct, Mode=TwoWay}" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,10" Text="Raise this only if calibration reports that the stick barely moved. 10% is enough on this base - a probe stops the moment its direction is certain, so it needs a movement that can be read, not a large one. First check that nothing is touching the stick, and that the base's own Spring is 0 in MOZA Cockpit - Pit House has no such setting in flight mode." />
                                        </StackPanel>
                                        <styles:SHExpander Header="Manual overrides">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Which way the base pushes when told to push. Calibration sets both from measurement; they are separate because this base does not treat the axes alike. Getting one wrong turns every wall on that axis into a shove toward the stops, so change them by hand only to undo an obviously wrong measurement." />
                                                <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantX, Mode=TwoWay}" Content="Invert push, left/right" Margin="0,2" />
                                                <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantY, Mode=TwoWay}" Content="Invert push, forward/back" Margin="0,2" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="Calibration measures spring direction on each axis separately from push direction. The generic base spring uses those measured signs; gate walls remain constant forces. Older rigs must measure again before enabling the new DirectInput base spring." />
                                                <styles:SHToggleCheckbox IsChecked="{Binding PolarityConfirmed, Mode=TwoWay}" Content="Polarity confirmed - remove the 10% force cap" Margin="0,8,0,0" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Text="Ticked by a calibration run in which all four probes gave a definite answer. Ticking it by hand puts the base to full force on an unmeasured polarity - the one case the cap exists for." />
                                            </StackPanel>
                                        </styles:SHExpander>
                                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75" Text="Once calibration succeeds the cap lifts by itself. Raise the overall gain slowly afterwards: this is a 12 Nm base." />
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <StackPanel x:Name="FinishSetupPanel">
                                <TextBlock x:Name="TabGateText" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" />
                                <styles:SHButtonSecondary Content="Finish setup" Click="OnFinishSetup" Padding="14,6" Margin="0,4,8,4" x:Name="FinishSetupButton" />
                            </StackPanel>
                            <StackPanel x:Name="CompletedOptionsPanel">
                                <styles:SHExpander Header="Pedals" Margin="0,8,0,8">
                                    <styles:SHSection x:Name="VirtualClutchSection" Title="PEDALS" ShowSeparator="True">
                                        <StackPanel Margin="0,4,0,8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Read from" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox SelectedIndex="{Binding ClutchSourceIndex, Mode=TwoWay}" Width="240">
                                                    <ComboBoxItem Content="The game's telemetry" />
                                                    <ComboBoxItem Content="The pedal itself" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="PedalPanel">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Pedals" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox x:Name="PedalCombo" Width="330" Margin="0,0,8,0" SelectionChanged="OnPedalDeviceSelected" />
                                                    <styles:SHButtonSecondary Click="OnRefreshPedalDevices" Content="Refresh" Padding="10,3" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <styles:SHButtonPrimary x:Name="PedalCaptureButton" Click="OnCapturePedal" Content="Press the clutch to bind it" Padding="12,4" Margin="0,0,10,0" />
                                                    <TextBlock x:Name="PedalCaptureHint" VerticalAlignment="Center" Opacity="0.85" />
                                                </StackPanel>
                                                <TextBlock x:Name="PedalReading" Opacity="0.85" Margin="0,0,0,6" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Press the button, hold still for a moment, then press the clutch all the way down and let it come back up. Which axis it is, which way it travels and how much slack it has at rest are all measured from that one press - nothing here needs to be typed. This binding describes your rig, so it is never written into a shared profile." />
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="The game's own clutch reading needs no setup and is right whenever the game reports the pedal at all. Read the pedal directly if your game does not report a clutch, or if the grind feels late: telemetry arrives at the game's update rate, which is tens of milliseconds old against a shift that is over in a couple of hundred. The pedal is opened non-exclusively, so the game keeps reading it too." />
                                        </StackPanel>
                                    </styles:SHSection>
                                </styles:SHExpander>
                                <styles:SHExpander Header="Hotkeys" Margin="0,8,0,8">
                                    <StackPanel>
                                        <styles:SHSection Title="FORCES AND LOCKOUT HOTKEYS" ShowSeparator="True">
                                            <StackPanel Margin="0,6,0,16">
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.75" Text="Bind these to a wheel button if you would rather not reach for the mouse. Release everything drops every held gear and stops output - worth binding somewhere you can hit without looking, for the same reason the warning above exists." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ToggleShifterFFB" FriendlyName="Turn the shifter's forces on or off" />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ReleaseAllGears" FriendlyName="Release everything (panic)" />
                                                <styles:SHSectionSeparator Margin="0,10,0,8" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.75" Text="The lockout key. Only does anything while a lockout is in a hard mode - set on Feel, or in the PRND lane section for the automatic. The lockout re-engages by itself on every start and every profile switch." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ToggleLockout" FriendlyName="Release or re-engage the lockout (hard mode)" />
                                                <styles:SHExpander Header="Separate engage / release keys (for a two-position switch)" Margin="0,6,0,0">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <ui:ControlsEditor ActionName="AB9ShifterPlugin.EngageLockout" FriendlyName="Engage the lockout" />
                                                        <ui:ControlsEditor ActionName="AB9ShifterPlugin.ReleaseLockout" FriendlyName="Release the lockout" />
                                                    </StackPanel>
                                                </styles:SHExpander>
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHSection Title="PROFILE HOTKEYS" ShowSeparator="True">
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Bind a wheel button or a key here and it walks around the profiles ticked below. Next profile on its own is the simple cycle button - with two profiles ticked it just alternates between them; Previous profile only earns a binding once there are three or more. Switching releases any held gear before the new gate is applied, so it is safe to press while driving." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.NextProfile" FriendlyName="Next profile" />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.PreviousProfile" FriendlyName="Previous profile" />
                                                <styles:SHSectionSeparator Margin="0,8,0,8" />
                                                <styles:SHToggleCheckbox x:Name="ConfirmSwitchCheck" Content="Thump the lever once per profile number after a switch" Click="OnConfirmProfileSwitchChanged" Margin="0,0,0,6" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" Text="Which profiles those keys walk through. Tick none and they walk through all of them." />
                                                <ItemsControl x:Name="CycleList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <styles:SHToggleCheckbox Content="{Binding Name}" IsChecked="{Binding InCycle, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10" Text="One thump for the first profile in the list, two for the second, and so on - so which one arrived can be counted by hand instead of read off a screen, which is the point of putting switching on a button in the first place. The gate is also eased in rather than switched on: forces are held at nothing while the lever comes back to centre, then wound up over a third of a second. Without that, switching pattern while sitting in a gear put the new gate's full force onto a lever that was hard over, and it oscillated." />
                                            </StackPanel>
                                        </styles:SHSection>
                                    </StackPanel>
                                </styles:SHExpander>
                                <styles:SHExpander Header="Diagnostics" Margin="0,8,0,8">
                                    <StackPanel>
                                        <styles:SHSection Title="READINGS" ShowSeparator="True">
                                            <StackPanel x:Name="ReadingsPanel" Margin="0,4,0,8">
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding AxisText}" Margin="0,2" />
                                                <TextBlock Text="{Binding StateText}" Margin="0,2" />
                                                <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHSection Title="RECORD A TRACE" ShowSeparator="True">
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Records every tick - position, speed and the exact force sent to the base - so a movement that feels wrong can be replayed and measured instead of described. Press record, make the movement that misbehaves, press stop, and tell me what you did. It keeps the last two minutes, so it can be left running through a whole session and still hold the moment something went wrong." />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <styles:SHButtonPrimary x:Name="RecordButton" Click="OnToggleRecord" Content="Start recording" Margin="0,0,8,0" Padding="14,4" />
                                                    <styles:SHButtonSecondary x:Name="OpenTracesButton" Click="OnOpenTraces" Content="Open trace folder" Padding="14,4" />
                                                </StackPanel>
                                                <TextBlock x:Name="RecordStatus" TextWrapping="Wrap" Opacity="0.85" />
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHExpander Header="Device and output">
                                            <StackPanel Margin="0,8,0,8">
                                                <ui:TitledSlider Title="FFB loop rate (Hz)" Minimum="100" Maximum="1000" TickFrequency="50" ShowResetButton="True" ResetValue="1000" Value="{Binding TickHz, Mode=TwoWay}" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="How often the gate is recomputed. Leave it at 1000: the base is the slow part of the loop, not this, so lowering it buys nothing and makes every wall arrive later. It is here to diagnose a struggling PC, not to tune feel. Gear output and the base's vendor and product ids are under Base and output in Options." />
                                            </StackPanel>
                                        </styles:SHExpander>
                                    </StackPanel>
                                </styles:SHExpander>
                                <styles:SHSection Title="MAINTENANCE" ShowSeparator="True">
                                    <StackPanel Margin="0,6,0,16">
                                        <styles:SHButtonSecondary Content="Review setup" Click="OnReviewSetup" Padding="14,6" Margin="0,4,8,4" />
                                        <styles:SHButtonSecondary Content="Reset everything" Click="OnResetEverything" Padding="14,6" Margin="0,4,8,4" />
                                        <TextBlock x:Name="VersionText" Margin="0,8,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </styles:SHSection>
                                <styles:SHSection Title="UPDATES" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <TextBlock Text="AB9 Active Shifter" FontWeight="Bold" />
                                        <TextBlock x:Name="UpdateInstalledVersionText" Margin="0,4,0,12" Opacity="0.75" />
                                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <styles:SHButtonSecondary x:Name="OptionsInstallButton" Content="Install update" Click="OnInstallUpdate" Visibility="Collapsed" Padding="10,4" Margin="0,0,6,4" />
                                            <styles:SHButtonSecondary x:Name="ReleaseNotesButton" Content="Open release notes" Click="OnOpenReleaseNotes" IsEnabled="False" Padding="10,4" Margin="0,0,6,4" />
                                            <styles:SHButtonSecondary x:Name="OptionsDismissButton" Content="Dismiss" Click="OnDismissUpdate" Visibility="Collapsed" Padding="10,4" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <StackPanel x:Name="ReleaseNotesPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                            <TextBlock x:Name="ReleaseNotesTitle" FontWeight="Bold" Margin="0,0,0,8" />
                                            <Border Background="#0C000000" Padding="12" CornerRadius="3">
                                                <RichTextBox x:Name="ReleaseNotesText" MaxHeight="300" IsReadOnly="True" IsDocumentEnabled="False" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </Border>
                                        </StackPanel>
                                        <styles:SHToggleCheckbox x:Name="AutomaticUpdatesToggle" Content="Check for updates automatically" Checked="OnAutomaticUpdatesChanged" Unchecked="OnAutomaticUpdatesChanged" />
                                        <TextBlock Text="Release channel: Stable" Opacity="0.75" Margin="0,8,0,8" />
                                        <WrapPanel>
                                            <styles:SHButtonSecondary x:Name="CheckUpdatesButton" Content="Check now" Click="OnCheckUpdates" Padding="10,4" Margin="0,0,12,0" />
                                            <TextBlock x:Name="UpdateLastCheckedText" VerticalAlignment="Center" Opacity="0.65" />
                                        </WrapPanel>
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,12,0,0" Text="Checks GitHub on startup and every six hours for a stable release. Install update downloads the plugin; Restart SimHub loads it when you are ready. Your profiles and calibration are kept." />
                                    </StackPanel>
                                </styles:SHSection>
                                <styles:SHExpander Header="About and acknowledgements" Margin="0,8,0,8">
                                    <styles:SHSection Title="ABOUT" ShowSeparator="True">
                                        <StackPanel Margin="0,4,0,8">
                                            <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="It drives a 12 Nm active device, and the risk is yours. The AB9 is a servo strong enough to hurt a wrist and to slam its own stops. This plugin computes its forces in software, several milliseconds of USB away from the motor, and a force rendered through that delay can go unstable and oscillate on its own. A defect, an unlucky combination of settings, or a stalled loop can make the base shake, kick or drive to a stop with no warning, which can injure you and damage hardware. You run it at your own risk: there is no warranty of any kind, and nobody is liable for injury or for damage to your equipment. Forces starting off, the 10% cap until polarity is measured, and the watchdog all reduce that risk - they do not remove it." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="Unofficial. Not affiliated with, endorsed by or supported by MOZA, SimHub or vJoy. MOZA and AB9 are named here only to say which hardware this works with. Do not take a problem caused by this plugin to MOZA's support - a base running it is being driven by third-party software they did not write." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="Early software, in active development and nowhere near polished. It has been built and tuned against exactly one base on one firmware revision, so its behaviour on yours is genuinely untested, and defaults, dial names and saved settings can still change between versions." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.6" Text="MIT licensed. The full text, the trademark notices and the attributions ship beside the plugin in LICENSE and NOTICE.md. github.com/Gugic/ab9-shifter-simhub-plugin" />
                                        </StackPanel>
                                    </styles:SHSection>
                                </styles:SHExpander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </styles:SHTabItem>
        </styles:SHTabControl>
        <Grid Visibility="Collapsed" Grid.Row="1" x:Name="DialogStorage">
            <ContentControl x:Name="FeelDialogHolder">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="FeelPanel">
                    <StackPanel Margin="12">
                        <TextBlock TextWrapping="Wrap" Text="Each block controls one part of the feel. Software strengths adjust in 0.1 steps; AB9 onboard controls use whole percentages. Increase gradually and try a few shifts before changing the next setting." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" />
                        <styles:SHSection Title="MASTER" ShowSeparator="True">
                            <StackPanel Margin="0,4,0,8">
                                <Border Style="{StaticResource TuningSettingCard}">
                                    <StackPanel>
                                        <local:ScaledTitledSlider ShowResetButton="True" Style="{StaticResource ScaledTuningSlider}" Title="Overall gain (%)" RawStep="0.1" RawMinimum="0" RawMaximum="100" RawResetValue="25" RawValue="{Binding OverallGainPct, Mode=TwoWay}" x:Name="TuningOverallGainPct1" />
                                        <TextBlock TextWrapping="Wrap" Text="Makes the whole shifter lighter or stronger, including feedback effects. Raise it gradually with a hand on the lever. An uncalibrated base stays limited to 10%." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" />
                                        <TextBlock TextWrapping="Wrap" Text="This saved setting is outside the usual adjustment range. It is kept as saved until you adjust this control." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" Visibility="{Binding HasValueOutsideScale, ElementName=TuningOverallGainPct1, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock x:Name="LockoutSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TuningSettingCard}">
                                    <StackPanel>
                                        <styles:SHButtonSecondary Click="OnResetForces" Content="Reset feel to defaults" Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                        <TextBlock TextWrapping="Wrap" Text="Restores strength and stability for this profile. Your geometry and game effects stay as they are." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="BASE EFFECTS" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <StackPanel x:Name="GenericBaseEffectsPanel">
                                    <TextBlock x:Name="BaseEffectsHeading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="DirectInput renders these base effects. Gate forces, software stability and telemetry effects remain available in either virtual mode." TextWrapping="Wrap" Margin="0,4,0,8" x:Name="BaseEffectsDescription" />
                                    <Border Style="{StaticResource TuningSettingCard}">
                                        <StackPanel>
                                            <local:ScaledTitledSlider ShowResetButton="True" x:Name="BaseSpringSlider" Style="{StaticResource ScaledTuningSlider}" Title="Base spring (%)" RawStep="0.1" RawMinimum="0" RawMaximum="100" RawResetValue="0" RawValue="{Binding BaseSpringPct, Mode=TwoWay}" />
                                            <TextBlock TextWrapping="Wrap" Text="Pulls the lever toward the base centre. Keep it low if you want the lever to rest naturally in a gear." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" />
                                            <TextBlock TextWrapping="Wrap" Text="This saved setting is outside the usual adjustment range. It is kept as saved until you adjust this control." Opacity="0.8" HorizontalAlignment="Left" MaxWidth="760" Margin="0,8,0,0" Visibility="{Binding HasValueOutsideScale, ElementName=BaseSpringSlider, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock x:Name="HandbrakeSpringHint" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed" Text="Handbrake return uses the configured start position. The base-centering spring is off in this pattern; use Return strength to tune the return." MaxWidth="760" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                            <TextBlock Text="Measure polarity again in Options to enable the DirectInput base spring. Other effects remain available." TextWrapping="Wrap" Margin="0,8,0,0" x:Name="BaseSpringCalibrationHint" MaxWidth="760" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
