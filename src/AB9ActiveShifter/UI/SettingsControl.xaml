<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AB9ActiveShifter.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins" xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AB9ActiveShifter.UI.SettingsControl" mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style TargetType="{x:Type ui:TitledSlider}">
            <Setter Property="ToolTip" Value="Right-click to undo the last adjustment." />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnSliderGestureStartMouse" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSliderGestureEndMouse" />
            <EventSetter Event="PreviewKeyDown" Handler="OnSliderGestureStartKey" />
            <EventSetter Event="PreviewKeyUp" Handler="OnSliderGestureEndKey" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Margin="8,8,8,4" Padding="12,8" Background="#22FFFFFF" CornerRadius="3">
            <WrapPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" FontWeight="SemiBold" Margin="0,4,16,4" />
                <styles:SHButtonSecondary x:Name="BannerInstallButton" Content="Install update" Click="OnInstallUpdate" Padding="10,4" Margin="0,2,6,2" />
                <styles:SHButtonSecondary Content="Open release notes" Click="OnOpenReleaseNotes" Padding="10,4" Margin="0,2,6,2" />
                <styles:SHButtonSecondary Content="Dismiss" Click="OnDismissUpdate" Padding="10,4" Margin="0,2,0,2" />
            </WrapPanel>
        </Border>
        <styles:SHTabControl Grid.Row="1" x:Name="WorkspaceTabs">
            <styles:SHTabItem Header="Main" x:Name="MainTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="MainWorkspaceGrid" Margin="16" SizeChanged="OnMainWorkspaceSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="0,0,0,12" Margin="0,0,0,16" BorderThickness="0,0,0,1" BorderBrush="#44505C" Grid.ColumnSpan="2">
                            <StackPanel x:Name="StatusPanel" Margin="0,4,0,8">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" x:Name="MainModeText" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <UniformGrid Columns="2">
                                    <TextBlock Text="{Binding DeviceText}" Margin="0,2" />
                                    <TextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Margin="0,2" />
                                    <TextBlock Text="{Binding GearText}" Margin="0,2" />
                                    <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                                </UniformGrid>
                                <styles:SHButtonSecondary Content="Device, output and options" Click="OnOpenOptions" Padding="14,6" Margin="0,4,8,4" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="MainProfilePanel" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <Border x:Name="ProfileSection" Padding="0,0,0,4">
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Profile and pattern" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="ProfileCombo" Margin="0" IsEditable="True" SelectionChanged="OnProfileSelected" HorizontalAlignment="Stretch" Grid.Column="1" />
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,12">
                                        <styles:SHButtonSecondary Click="OnAddProfile" Content="Duplicate" Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary x:Name="RenameProfileButton" Click="OnRenameProfile" Content="Rename" Padding="8,3" Margin="0,4,6,0" ToolTip="Type a new name in the profile box, then click Rename." />
                                        <styles:SHButtonSecondary x:Name="DeleteProfileButton" Click="OnDeleteProfile" Content="Delete" Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary Click="OnExportProfile" Content="Export..." Padding="8,3" Margin="0,4,6,0" />
                                        <styles:SHButtonSecondary Click="OnImportProfile" Content="Import..." Padding="8,3" Margin="0,4,6,0" />
                                    </WrapPanel>
                                    <TextBlock x:Name="PresetNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" Visibility="Collapsed" Text="Shipped preset. Changing a dial creates an editable copy; the preset stays available as a starting point." />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox SelectedIndex="{Binding PatternIndex, Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="H pattern, 7 gears + R (lockout)" />
                                            <ComboBoxItem Content="H pattern, 6 gears + R (no 7th slot)" />
                                            <ComboBoxItem Content="H pattern, 5 gears + R" />
                                            <ComboBoxItem Content="Sequential (+ / -)" />
                                            <ComboBoxItem Content="Automatic (P R N D)" />
                                            <ComboBoxItem Content="H pattern, 6 gears, no reverse (truck)" />
                                        </ComboBox>
                                    </Grid>
                                    <ui:TitledSlider x:Name="VirtualSequentialPulse" Title="Sequential pulse length (ms)" Minimum="20" Maximum="400" TickFrequency="10" ShowResetButton="True" ResetValue="120" Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}" Value="{Binding SeqPulseMs, Mode=TwoWay}" Margin="0,4,0,8" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,0,0,8">
                                <Border x:Name="VirtualEnableSection" Margin="0,4,0,4" Padding="0">
                                    <StackPanel Margin="0">
                                        <styles:SHToggleCheckbox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="Shifter force feedback enabled" Margin="0" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="VirtualFreeStickSection" Margin="0,4,0,4" Padding="0">
                                    <StackPanel Margin="0">
                                        <styles:SHToggleCheckbox IsChecked="{Binding FreeStick, Mode=TwoWay}" Content="Release all forces (free stick)" Margin="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,12" x:Name="TuningButtons">
                                <styles:SHButtonSecondary Content="Geometry…" Click="OnOpenGeometry" Padding="14,6" Margin="0,0,8,0" x:Name="OpenGeometryButton" />
                                <styles:SHButtonSecondary Content="Feel…" Click="OnOpenFeel" Padding="14,6" Margin="0,0,8,0" x:Name="OpenFeelButton" />
                                <styles:SHButtonSecondary Content="Effects…" Click="OnOpenEffects" Padding="14,6" Margin="0,0,8,0" x:Name="OpenEffectsButton" />
                            </WrapPanel>
                            <styles:SHExpander Header="Automatic profile switching" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="Use this profile when the game changes to a matching vehicle. Enter one vehicle ID per line, or leave empty to select profiles manually." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                                    <TextBox x:Name="CarModelsBox" AcceptsReturn="True" Height="82" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" LostFocus="OnCarModelsChanged" ToolTip="Use the vehicle ID reported by DataCorePlugin.GameData.CarModel in SimHub’s available properties. The first matching profile in the list wins." />
                                    <WrapPanel Margin="0,6,0,4">
                                        <styles:SHButtonSecondary x:Name="AddLastCarButton" Click="OnAddLastCarModel" Content="Add last vehicle" Padding="8,3" Margin="0,0,6,4" />
                                        <styles:SHButtonSecondary Click="OnAddBlankCarModelLine" Content="Add manually" Padding="8,3" ToolTip="Adds a blank line to the box above so you can type an id by hand" Margin="0,0,6,4" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LastCarModelText" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
                                </StackPanel>
                            </styles:SHExpander>
                            <styles:SHExpander Header="Sharing and button mapping" Margin="0,0,0,8">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Duplicate creates an editable copy. Export shares the tune; Import adds a new profile with forces off and keeps this rig’s device settings and calibration." TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                                    <TextBlock x:Name="OutputBindingSummary" TextWrapping="Wrap" Opacity="0.8" Margin="0" />
                                </StackPanel>
                            </styles:SHExpander>
                        </StackPanel>
                        <Border x:Name="MainLivePanel" Grid.Row="1" Grid.Column="1" Padding="12" Background="#0C000000" CornerRadius="4" VerticalAlignment="Top">
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="Live gate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <local:GateVisualizer x:Name="Visualizer" Height="340" HorizontalAlignment="Stretch" />
                                <styles:SHExpander Header="Reading the live monitor" Margin="0,4,0,8">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="The dot is the stick, and the shaded area is the gate's free space - drawn at the size the geometry actually makes it, so every dial on Geometry moves something here. The orange band is the lockout: in the neutral channel it pushes back toward the paying side until you push through - or, in a hard mode, until the release key opens it, and the band dims while released." />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="Blue marks are what the plugin measures rather than what the hand feels: the solid lines across each slot are the engage depth, where the gear registers, and the dashed ones the release depth, where it lets go. The blue brackets on the tunnel edge are how wide each column's doorway opens, and the dashed blue pairs in the tunnel are the column handover width. The faint dashed verticals are the ownership boundaries - past one of those, a push that beats the wall lands in the next column's slot." />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" x:Name="MainRecordStatus" />
                            <styles:SHExpander Header="Using forces and free stick" Margin="0,4,0,8">
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="Enable after setup. Turning this off releases the base for another application." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="This is a 12 Nm base and this is third-party software driving it: if the lever ever shakes, kicks or drives itself to a stop, untick this - and if it will not stop, cut the base's power. Keep your face and free hand clear the first time you enable a profile you have not felt before. See ABOUT in Options." />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" Text="Releases the plugin’s forces while keeping its device connection. Onboard base effects can still resist movement in AB9-native mode." />
                                </StackPanel>
                            </styles:SHExpander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </styles:SHTabItem>
            <styles:SHTabItem Header="Options" x:Name="OptionsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <StackPanel x:Name="SetupIntro">
                            <TextBlock Text="Set up your shifter" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a mode, prepare the base, select the output and measure polarity. Once complete, Main becomes the everyday workspace." TextWrapping="Wrap" Margin="0,4,0,8" />
                        </StackPanel>
                        <styles:SHSection Title="OPERATING MODE" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <ComboBox Width="300" HorizontalAlignment="Left" SelectionChanged="OnOperatingModeSelected" Margin="0,4,0,8" x:Name="OperatingModeCombo">
                                    <ComboBoxItem Content="AB9-native" Tag="Ab9Native" />
                                    <ComboBoxItem Content="Generic FFB Stick" Tag="GenericFfbStick" />
                                    <ComboBoxItem Content="AB9 H-pattern" Tag="Ab9HPattern" />
                                </ComboBox>
                                <TextBlock Text="AB9-native uses onboard base effects with our virtual shifter. Generic FFB Stick uses DirectInput base effects. AB9 H-pattern hands control to the firmware shifter." TextWrapping="Wrap" Margin="0,4,0,8" />
                                <TextBlock x:Name="NativeStatusText" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <styles:SHButtonSecondary Content="Refresh AB9" Click="OnNativeRefresh" Padding="14,6" Margin="0,4,8,4" x:Name="NativeRefreshButton" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" x:Name="NativeOperationText" />
                                <TextBlock Text="The AB9 firmware owns the shifter and its buttons. Plugin profiles, tuning, gear output and effects are unavailable in this mode. Choose another mode to return." TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,8" x:Name="HPatternNotice" />
                            </StackPanel>
                        </styles:SHSection>
                        <StackPanel x:Name="VirtualOptionsPanel">
                            <styles:SHExpander x:Name="PrepareGroup" Header="Prepare the base" Margin="0,8,0,8">
                                <styles:SHSection Title="" ShowSeparator="True" x:Name="PrepareSection">
                                    <StackPanel Margin="0,6,0,16">
                                        <TextBlock Text="In AB9-native mode, Prepare base selects flight mode and configures base effects. In Generic FFB Stick mode, use the checklist below with your base’s settings app." TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <styles:SHButtonSecondary Content="Prepare base" Click="OnPrepareSelectedMode" Padding="14,6" Margin="0,4,8,4" x:Name="PrepareBaseButton" />
                                        <styles:SHSection x:Name="VirtualChecklistSection" Title="BEFORE YOU START" ShowSeparator="True">
                                            <TextBlock TextWrapping="Wrap">Use your base’s settings app to remove built-in centring and select DirectInput force feedback. Close any application holding the base exclusively. Choose direct vJoy or SimHub Control Mapper below, configure that output, then bind its buttons or keys in your game.</TextBlock>
                                        </styles:SHSection>
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <styles:SHExpander x:Name="OutputGroup" Header="Base and output" Margin="0,8,0,8">
                                <styles:SHSection x:Name="VirtualOutputSection" Title="" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <Grid Margin="0,0,0,10" MaxWidth="650" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Output" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Width="330" HorizontalAlignment="Left" SelectedIndex="{Binding OutputModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="vJoy (direct)" />
                                                <ComboBoxItem Content="SimHub Control Mapper (native)" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel x:Name="VJoyPanel">
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="Device" VerticalAlignment="Center" Width="80" />
                                                <ComboBox x:Name="VJoyCombo" Width="330" Margin="0,0,8,0" SelectionChanged="OnVJoyDeviceSelected" />
                                                <styles:SHButtonSecondary Click="OnRefreshVJoyDevices" Content="Refresh" Padding="10,3" />
                                            </WrapPanel>
                                            <TextBlock x:Name="VJoyHint" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,0" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" Text="Choose a dedicated virtual device that carries gears into your game. Create or resize it in vJoyConf, then refresh. H patterns use up to 8 buttons, sequential uses 9–10, and PRND uses 11–14. If Control Mapper also uses vJoy, give it a different device." />
                                        </StackPanel>
                                        <StackPanel x:Name="ControlMapperPanel" Visibility="Collapsed">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Control Mapper is a separate SimHub feature from Controls and events. Enable it below if needed, configure its output and roles, then assign existing roles here. Control Mapper can send keyboard keys, vJoy or Arduino bridge buttons, or SimHub controls. This output choice is separate from the AB9 operating mode." />
                                            <TextBlock x:Name="ControlMapperStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <styles:SHButtonSecondary x:Name="EnableControlMapperButton" Content="Enable Control Mapper and restart SimHub" Click="OnEnableControlMapper" Padding="10,3" Margin="0,0,8,4" />
                                                <styles:SHButtonSecondary x:Name="ConfigureControlMapperButton" Content="Configure Control Mapper" Click="OnConfigureControlMapper" Padding="10,3" Margin="0,0,8,4" />
                                                <styles:SHButtonSecondary Content="Refresh roles" Click="OnRefreshControlMapperRoles" Padding="10,3" Margin="0,0,0,4" />
                                            </WrapPanel>
                                            <ItemsControl x:Name="ControlMapperMappings">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" MaxWidth="650" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="210" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <ComboBox Grid.Column="1" MinWidth="180" IsEditable="True" ItemsSource="{Binding AvailableRoles}" Text="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Choose or type an existing Control Mapper role. Leave blank to send nothing." />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="ControlMapperHint" TextWrapping="Wrap" Opacity="0.85" Margin="0,8,0,0" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" Text="H gears and PRND positions hold their roles; sequential shifts use the pulse length on Main. H-pattern neutral is optional. Blank mappings send nothing. Check direct-gear and neutral keyboard bindings in your game. These assignments belong to the rig and survive profile switches." />
                                        </StackPanel>
                                        <styles:SHExpander Header="Base device identity" Margin="0,8,0,0">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="The base is matched by USB vendor and product id, written in hex as Device Manager shows them. The AB9 is 346E / 1000; only change these if your base enumerates differently. This lives here rather than with the other advanced settings because a base that is not found is exactly the case where the tuning base is not yet ready." />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Vendor id" VerticalAlignment="Center" Width="80" />
                                                    <TextBox Text="{Binding VendorIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" Margin="0,0,16,0" />
                                                    <TextBlock Text="Product id" VerticalAlignment="Center" Width="80" />
                                                    <TextBox Text="{Binding ProductIdHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" />
                                                </StackPanel>
                                            </StackPanel>
                                        </styles:SHExpander>
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <styles:SHExpander x:Name="CalibrationGroup" Header="Polarity calibration" Margin="0,8,0,8">
                                <styles:SHSection x:Name="VirtualCalibrationSection" Title="" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <StackPanel x:Name="CalibrationDonePanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <TextBlock x:Name="CalibrationSummary" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
                                            <styles:SHButtonSecondary Click="OnRecalibrate" Content="Measure again" Padding="14,4" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel x:Name="CalibrationFullPanel">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Some AB9 firmware versions apply DirectInput effects backwards, which would turn a centring spring into one that throws the stick at its stops. Until this is measured the plugin caps its force at 10%, and setup remains incomplete." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Calibration applies a short push each way and watches which way the stick actually moves, so it works even though the base holds itself centred. Take your hands off the stick and leave them off - anything resisting the stick will spoil the measurement. It takes about four seconds." />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <styles:SHButtonPrimary x:Name="CalibrateButton" Click="OnCalibrate" Content="Measure polarity" Margin="0,0,8,0" Padding="14,4" />
                                                <styles:SHButtonSecondary x:Name="CancelCalibrationButton" Click="OnCancelCalibration" Content="Cancel" Padding="14,4" />
                                            </StackPanel>
                                            <Border x:Name="CalibrationResultBorder" Padding="10,8" Margin="0,0,0,8" Background="#22FFFFFF" CornerRadius="3" Visibility="Collapsed">
                                                <StackPanel x:Name="CalibrationResultPanel" />
                                            </Border>
                                            <ui:TitledSlider Title="Calibration force (%)" Minimum="5" Maximum="60" TickFrequency="5" ShowResetButton="True" ResetValue="10" Value="{Binding CalibrationForcePct, Mode=TwoWay}" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,10" Text="Raise this only if calibration reports that the stick barely moved. 10% is enough on this base - a probe stops the moment its direction is certain, so it needs a movement that can be read, not a large one. First check that nothing is touching the stick, and that the base's own Spring is 0 in MOZA Cockpit - Pit House has no such setting in flight mode." />
                                        </StackPanel>
                                        <styles:SHExpander Header="Manual overrides">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Which way the base pushes when told to push. Calibration sets both from measurement; they are separate because this base does not treat the axes alike. Getting one wrong turns every wall on that axis into a shove toward the stops, so change them by hand only to undo an obviously wrong measurement." />
                                                <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantX, Mode=TwoWay}" Content="Invert push, left/right" Margin="0,2" />
                                                <styles:SHToggleCheckbox IsChecked="{Binding InvertConstantY, Mode=TwoWay}" Content="Invert push, forward/back" Margin="0,2" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="Calibration measures spring direction on each axis separately from push direction. The generic base spring uses those measured signs; gate walls remain constant forces. Older rigs must measure again before enabling the new DirectInput base spring." />
                                                <styles:SHToggleCheckbox IsChecked="{Binding PolarityConfirmed, Mode=TwoWay}" Content="Polarity confirmed - remove the 10% force cap" Margin="0,8,0,0" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Text="Ticked by a calibration run in which all four probes gave a definite answer. Ticking it by hand puts the base to full force on an unmeasured polarity - the one case the cap exists for." />
                                            </StackPanel>
                                        </styles:SHExpander>
                                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75" Text="Once calibration succeeds the cap lifts by itself. Raise the overall gain slowly afterwards: this is a 12 Nm base." />
                                    </StackPanel>
                                </styles:SHSection>
                            </styles:SHExpander>
                            <StackPanel x:Name="FinishSetupPanel">
                                <TextBlock x:Name="TabGateText" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" />
                                <styles:SHButtonSecondary Content="Finish setup" Click="OnFinishSetup" Padding="14,6" Margin="0,4,8,4" x:Name="FinishSetupButton" />
                            </StackPanel>
                            <StackPanel x:Name="CompletedOptionsPanel">
                                <styles:SHExpander Header="Pedals" Margin="0,8,0,8">
                                    <styles:SHSection x:Name="VirtualClutchSection" Title="PEDALS" ShowSeparator="True">
                                        <StackPanel Margin="0,4,0,8">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Read from" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox SelectedIndex="{Binding ClutchSourceIndex, Mode=TwoWay}" Width="240">
                                                    <ComboBoxItem Content="The game's telemetry" />
                                                    <ComboBoxItem Content="The pedal itself" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="PedalPanel">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Pedals" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox x:Name="PedalCombo" Width="330" Margin="0,0,8,0" SelectionChanged="OnPedalDeviceSelected" />
                                                    <styles:SHButtonSecondary Click="OnRefreshPedalDevices" Content="Refresh" Padding="10,3" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <styles:SHButtonPrimary x:Name="PedalCaptureButton" Click="OnCapturePedal" Content="Press the clutch to bind it" Padding="12,4" Margin="0,0,10,0" />
                                                    <TextBlock x:Name="PedalCaptureHint" VerticalAlignment="Center" Opacity="0.85" />
                                                </StackPanel>
                                                <TextBlock x:Name="PedalReading" Opacity="0.85" Margin="0,0,0,6" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Press the button, hold still for a moment, then press the clutch all the way down and let it come back up. Which axis it is, which way it travels and how much slack it has at rest are all measured from that one press - nothing here needs to be typed. This binding describes your rig, so it is never written into a shared profile." />
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="The game's own clutch reading needs no setup and is right whenever the game reports the pedal at all. Read the pedal directly if your game does not report a clutch, or if the grind feels late: telemetry arrives at the game's update rate, which is tens of milliseconds old against a shift that is over in a couple of hundred. The pedal is opened non-exclusively, so the game keeps reading it too." />
                                        </StackPanel>
                                    </styles:SHSection>
                                </styles:SHExpander>
                                <styles:SHExpander Header="Hotkeys" Margin="0,8,0,8">
                                    <StackPanel>
                                        <styles:SHSection Title="FORCES AND LOCKOUT HOTKEYS" ShowSeparator="True">
                                            <StackPanel Margin="0,6,0,16">
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.75" Text="Bind these to a wheel button if you would rather not reach for the mouse. Release everything drops every held gear and stops output - worth binding somewhere you can hit without looking, for the same reason the warning above exists." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ToggleShifterFFB" FriendlyName="Turn the shifter's forces on or off" />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ReleaseAllGears" FriendlyName="Release everything (panic)" />
                                                <styles:SHSectionSeparator Margin="0,10,0,8" />
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.75" Text="The lockout key. Only does anything while a lockout is in a hard mode - set on Feel, or in the PRND lane section for the automatic. The lockout re-engages by itself on every start and every profile switch." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.ToggleLockout" FriendlyName="Release or re-engage the lockout (hard mode)" />
                                                <styles:SHExpander Header="Separate engage / release keys (for a two-position switch)" Margin="0,6,0,0">
                                                    <StackPanel Margin="0,8,0,0">
                                                        <ui:ControlsEditor ActionName="AB9ShifterPlugin.EngageLockout" FriendlyName="Engage the lockout" />
                                                        <ui:ControlsEditor ActionName="AB9ShifterPlugin.ReleaseLockout" FriendlyName="Release the lockout" />
                                                    </StackPanel>
                                                </styles:SHExpander>
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHSection Title="PROFILE HOTKEYS" ShowSeparator="True">
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Bind a wheel button or a key here and it walks around the profiles ticked below. Next profile on its own is the simple cycle button - with two profiles ticked it just alternates between them; Previous profile only earns a binding once there are three or more. Switching releases any held gear before the new gate is applied, so it is safe to press while driving." />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.NextProfile" FriendlyName="Next profile" />
                                                <ui:ControlsEditor ActionName="AB9ShifterPlugin.PreviousProfile" FriendlyName="Previous profile" />
                                                <styles:SHSectionSeparator Margin="0,8,0,8" />
                                                <styles:SHToggleCheckbox x:Name="ConfirmSwitchCheck" Content="Thump the lever once per profile number after a switch" Click="OnConfirmProfileSwitchChanged" Margin="0,0,0,6" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6" Text="Which profiles those keys walk through. Tick none and they walk through all of them." />
                                                <ItemsControl x:Name="CycleList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <styles:SHToggleCheckbox Content="{Binding Name}" IsChecked="{Binding InCycle, Mode=TwoWay}" Margin="0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10" Text="One thump for the first profile in the list, two for the second, and so on - so which one arrived can be counted by hand instead of read off a screen, which is the point of putting switching on a button in the first place. The gate is also eased in rather than switched on: forces are held at nothing while the lever comes back to centre, then wound up over a third of a second. Without that, switching pattern while sitting in a gear put the new gate's full force onto a lever that was hard over, and it oscillated." />
                                            </StackPanel>
                                        </styles:SHSection>
                                    </StackPanel>
                                </styles:SHExpander>
                                <styles:SHExpander Header="Diagnostics" Margin="0,8,0,8">
                                    <StackPanel>
                                        <styles:SHSection Title="READINGS" ShowSeparator="True">
                                            <StackPanel x:Name="ReadingsPanel" Margin="0,4,0,8">
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding AxisText}" Margin="0,2" />
                                                <TextBlock Text="{Binding StateText}" Margin="0,2" />
                                                <TextBlock Text="{Binding LoopText}" Margin="0,2" />
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHSection Title="RECORD A TRACE" ShowSeparator="True">
                                            <StackPanel Margin="0,4,0,8">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" Text="Records every tick - position, speed and the exact force sent to the base - so a movement that feels wrong can be replayed and measured instead of described. Press record, make the movement that misbehaves, press stop, and tell me what you did. It keeps the last two minutes, so it can be left running through a whole session and still hold the moment something went wrong." />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <styles:SHButtonPrimary x:Name="RecordButton" Click="OnToggleRecord" Content="Start recording" Margin="0,0,8,0" Padding="14,4" />
                                                    <styles:SHButtonSecondary x:Name="OpenTracesButton" Click="OnOpenTraces" Content="Open trace folder" Padding="14,4" />
                                                </StackPanel>
                                                <TextBlock x:Name="RecordStatus" TextWrapping="Wrap" Opacity="0.85" />
                                            </StackPanel>
                                        </styles:SHSection>
                                        <styles:SHExpander Header="Device and output">
                                            <StackPanel Margin="0,8,0,8">
                                                <ui:TitledSlider Title="FFB loop rate (Hz)" Minimum="100" Maximum="1000" TickFrequency="50" ShowResetButton="True" ResetValue="1000" Value="{Binding TickHz, Mode=TwoWay}" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="How often the gate is recomputed. Leave it at 1000: the base is the slow part of the loop, not this, so lowering it buys nothing and makes every wall arrive later. It is here to diagnose a struggling PC, not to tune feel. Gear output and the base's vendor and product ids are under Base and output in Options." />
                                            </StackPanel>
                                        </styles:SHExpander>
                                    </StackPanel>
                                </styles:SHExpander>
                                <styles:SHSection Title="MAINTENANCE" ShowSeparator="True">
                                    <StackPanel Margin="0,6,0,16">
                                        <styles:SHButtonSecondary Content="Review setup" Click="OnReviewSetup" Padding="14,6" Margin="0,4,8,4" />
                                        <styles:SHButtonSecondary Content="Reset everything" Click="OnResetEverything" Padding="14,6" Margin="0,4,8,4" />
                                        <TextBlock x:Name="VersionText" Margin="0,8,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </styles:SHSection>
                                <styles:SHSection Title="UPDATES" ShowSeparator="True">
                                    <StackPanel Margin="0,4,0,8">
                                        <TextBlock Text="AB9 Active Shifter" FontWeight="Bold" />
                                        <TextBlock x:Name="UpdateInstalledVersionText" Margin="0,4,0,12" Opacity="0.75" />
                                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <styles:SHButtonSecondary x:Name="OptionsInstallButton" Content="Install update" Click="OnInstallUpdate" Visibility="Collapsed" Padding="10,4" Margin="0,0,6,4" />
                                            <styles:SHButtonSecondary x:Name="ReleaseNotesButton" Content="Open release notes" Click="OnOpenReleaseNotes" IsEnabled="False" Padding="10,4" Margin="0,0,6,4" />
                                            <styles:SHButtonSecondary x:Name="OptionsDismissButton" Content="Dismiss" Click="OnDismissUpdate" Visibility="Collapsed" Padding="10,4" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <StackPanel x:Name="ReleaseNotesPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                            <TextBlock x:Name="ReleaseNotesTitle" FontWeight="Bold" Margin="0,0,0,8" />
                                            <Border Background="#0C000000" Padding="12" CornerRadius="3">
                                                <RichTextBox x:Name="ReleaseNotesText" MaxHeight="300" IsReadOnly="True" IsDocumentEnabled="False" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </Border>
                                        </StackPanel>
                                        <styles:SHToggleCheckbox x:Name="AutomaticUpdatesToggle" Content="Check for updates automatically" Checked="OnAutomaticUpdatesChanged" Unchecked="OnAutomaticUpdatesChanged" />
                                        <TextBlock Text="Release channel: Stable" Opacity="0.75" Margin="0,8,0,8" />
                                        <WrapPanel>
                                            <styles:SHButtonSecondary x:Name="CheckUpdatesButton" Content="Check now" Click="OnCheckUpdates" Padding="10,4" Margin="0,0,12,0" />
                                            <TextBlock x:Name="UpdateLastCheckedText" VerticalAlignment="Center" Opacity="0.65" />
                                        </WrapPanel>
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,12,0,0" Text="Checks GitHub on startup and every six hours for a stable release. Install update downloads the plugin; Restart SimHub loads it when you are ready. Your profiles and calibration are kept." />
                                    </StackPanel>
                                </styles:SHSection>
                                <styles:SHExpander Header="About and acknowledgements" Margin="0,8,0,8">
                                    <styles:SHSection Title="ABOUT" ShowSeparator="True">
                                        <StackPanel Margin="0,4,0,8">
                                            <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="It drives a 12 Nm active device, and the risk is yours. The AB9 is a servo strong enough to hurt a wrist and to slam its own stops. This plugin computes its forces in software, several milliseconds of USB away from the motor, and a force rendered through that delay can go unstable and oscillate on its own. A defect, an unlucky combination of settings, or a stalled loop can make the base shake, kick or drive to a stop with no warning, which can injure you and damage hardware. You run it at your own risk: there is no warranty of any kind, and nobody is liable for injury or for damage to your equipment. Forces starting off, the 10% cap until polarity is measured, and the watchdog all reduce that risk - they do not remove it." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="Unofficial. Not affiliated with, endorsed by or supported by MOZA, SimHub or vJoy. MOZA and AB9 are named here only to say which hardware this works with. Do not take a problem caused by this plugin to MOZA's support - a base running it is being driven by third-party software they did not write." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" Text="Early software, in active development and nowhere near polished. It has been built and tuned against exactly one base on one firmware revision, so its behaviour on yours is genuinely untested, and defaults, dial names and saved settings can still change between versions." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.6" Text="MIT licensed. The full text, the trademark notices and the attributions ship beside the plugin in LICENSE and NOTICE.md. github.com/Gugic/ab9-shifter-simhub-plugin" />
                                        </StackPanel>
                                    </styles:SHSection>
                                </styles:SHExpander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </styles:SHTabItem>
        </styles:SHTabControl>
        <Grid Visibility="Collapsed" Grid.Row="1" x:Name="DialogStorage">
            <ContentControl x:Name="FeelDialogHolder">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="FeelPanel">
                    <StackPanel Margin="12">
                        <styles:SHSection Title="MASTER" ShowSeparator="True">
                            <StackPanel Margin="0,4,0,8">
                                <ui:TitledSlider Title="Overall gain (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="25" Value="{Binding OverallGainPct, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="Scales everything the gate produces - walls, detents, the lockout and the telemetry buzzes alike - so it is the one dial to reach for if the whole shifter is too strong or too weak. This is a 12 Nm base: raise it in small steps with a hand on the stick. Until polarity has been measured it is capped at 10% whatever this says." />
                                <TextBlock x:Name="LockoutSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                                <styles:SHButtonSecondary Click="OnResetForces" Content="Reset feel to defaults" Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Text="Resets strength, base effects and force stability for this profile. Geometry and telemetry effects keep their current values." />
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="BASE EFFECTS" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <StackPanel x:Name="GenericBaseEffectsPanel">
                                    <TextBlock x:Name="BaseEffectsHeading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="DirectInput renders these base effects. Gate forces, software stability and telemetry effects remain available in either virtual mode." TextWrapping="Wrap" Margin="0,4,0,8" x:Name="BaseEffectsDescription" />
                                    <ui:TitledSlider Title="Base spring (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="0" Value="{Binding BaseSpringPct, Mode=TwoWay}" x:Name="BaseSpringSlider" />
                                    <ui:TitledSlider Title="Base damper (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="8" Value="{Binding BaseDamperPct, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Base friction (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="0" Value="{Binding BaseFrictionPct, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Base inertia (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="0" Value="{Binding BaseInertiaPct, Mode=TwoWay}" />
                                    <TextBlock Text="Measure polarity again in Options to enable the DirectInput base spring. Other effects remain available." TextWrapping="Wrap" Margin="0,4,0,8" x:Name="BaseSpringCalibrationHint" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" x:Name="NativeSettingsStatus" />
                                </StackPanel>
                                <styles:SHExpander Header="AB9 hardware gains" x:Name="NativeHardwareExpander" Margin="0,8,0,8">
                                    <StackPanel x:Name="NativeTunePanel">
                                        <TextBlock Text="These hardware gains multiply the force produced by the AB9. Changes apply automatically after you pause editing; successful updates keep your force feedback toggle as set." TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <ui:TitledSlider Title="Maximum Torque Output (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="100" Value="{Binding NativeTorquePct, Mode=TwoWay}" />
                                        <ui:TitledSlider Title="Overall Force Feedback Intensity (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="100" Value="{Binding NativeOverallIntensityPct, Mode=TwoWay}" />
                                        <ui:TitledSlider Title="Game Force Feedback Gain (%)" Minimum="0" Maximum="100" ShowResetButton="True" ResetValue="100" Value="{Binding NativeGameGainPct, Mode=TwoWay}" />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="GATE WALL STRENGTH" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Every wall is a percentage of full force, so 90% is a wall you cannot push through by hand. These are the same kind of force as the lockout, which is why they can be made properly solid." />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Text="This shows the wall you feel pushing back if you drift away from centre without lining up on a column: nothing at all for a short free stretch, then a quick ramp up to a wall you cannot push through by hand once past it. Line up with a column instead and this wall gets out of the way entirely - blocking everywhere except where a gear actually is is the whole job of the gate." />
                                <local:GateWallCurveVisualizer x:Name="GateWallCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" />
                                <ui:TitledSlider Title="Gate wall, between columns (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="90" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Value="{Binding ChannelWallForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Slot wall / lateral rail (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="90" Value="{Binding ColumnPinForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Fore/aft drag while on a column (%)" Minimum="0" Maximum="40" TickFrequency="1" ShowResetButton="True" ResetValue="5" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Value="{Binding ChannelGuideForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Wall at the pattern edge (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="100" Value="{Binding PatternEdgeForcePct, Mode=TwoWay}" />
                                <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="What stops the lever wandering off the side of a narrowed pattern. Outside the outermost columns there is bare travel with no gear in it, and the neutral tunnel is deliberately free everywhere else, so without this the lever slides to the base's own stop with nothing to say the gate ended. It is one-sided - it only ever pushes back in, never out - so it is a wall rather than a centring force, and it is zero everywhere inside the pattern. At 100% width it renders nothing at all, whatever it is set to: the outer columns are already at the stops and there is no room outside them." />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="THROW AND SLOT END-STOP STRENGTH" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,6,0,16">
                                <ui:TitledSlider Title="Slot end-stop wall (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="0" Value="{Binding SlotStopForcePct, Mode=TwoWay}" />
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="SEQUENTIAL STROKE STRENGTH" ShowSeparator="True" Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,6,0,16">
                                <ui:TitledSlider Title="Shift click kick (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="60" Value="{Binding SeqClickPct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="End-stop wall (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="90" Value="{Binding SeqStopForcePct, Mode=TwoWay}" />
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="PRND DETENTS AND LOCKOUT" ShowSeparator="True" Visibility="{Binding IsPrnd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,6,0,16">
                                <local:PrndLaneVisualizer x:Name="PrndLaneCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <ui:TitledSlider Title="Detent between positions (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="45" Value="{Binding PrndDetentForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="End-stop wall past P and D (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="90" Value="{Binding PrndStopForcePct, Mode=TwoWay}" />
                                <StackPanel Visibility="{Binding HasPrndLockout, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Lockout mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding PrndLockoutModeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Push through - a toll your hand can beat" />
                                            <ComboBoxItem Content="Hard - full force until released by hotkey" />
                                            <ComboBoxItem Content="Hard - re-arms itself after each crossing" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6" Visibility="{Binding IsPrndLockoutHardMode, Converter={StaticResource BoolToVis}}" Text="Force only, always: the selector still registers whichever position the lever physically reaches - a selector is never allowed a moment with nothing selected. Bind the release key in Options → Hotkeys; the gate re-engages on every start and every profile switch." />
                                    <ui:TitledSlider Title="PRND lockout force (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="70" Value="{Binding PrndLockoutForcePct, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="CROSSING THE GATE" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,6,0,16">
                                <local:SlidingAcrossGateVisualizer x:Name="SlidingAcrossGateCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding ShowsLockoutDials, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Lockout mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding LockoutModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Push through - a toll your hand can beat" />
                                        <ComboBoxItem Content="Hard - full force until released by hotkey" />
                                        <ComboBoxItem Content="Hard - re-arms itself after each crossing" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6" Visibility="{Binding IsLockoutHardMode, Converter={StaticResource BoolToVis}}" Text="Hard means the gate runs at 100% - the force dial below is idle - and locked gears do not register at all until the bound key releases the gate (bind it in Options → Hotkeys). It is still a force: a determined shove can beat 12 Nm, but the gear stays refused until the key turns. The gate re-engages on every start and every profile switch." />
                                <ui:TitledSlider Title="Lockout force (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="70" Visibility="{Binding ShowsLockoutDials, Converter={StaticResource BoolToVis}}" Value="{Binding LockoutForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Humps between the other columns (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="15" Value="{Binding BarrierForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Pull into a column (%)" Minimum="0" Maximum="60" TickFrequency="1" ShowResetButton="True" ResetValue="12" Value="{Binding ColumnDetentForcePct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Neutral spring toward 3/4 (%)" Minimum="0" Maximum="60" TickFrequency="5" ShowResetButton="True" ResetValue="0" Value="{Binding HomeSpringPct, Mode=TwoWay}" />
                                <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="What the hand feels moving along the neutral channel: a light pull into each column, a hump to climb between the ordinary columns, and - where one is configured - the lockout gate: a fight flat across a compact band, so a fast flick pays the same price as a slow push, and free travel beyond. Geometry sets its position, direction and width; the dials here set its resistance and release behavior; its width times its force is the toll, so if slams still get through, widen or strengthen it. The graph shows this across the whole width of the gate, coloured band and all; the white dot tracks where the stick actually is while sliding." />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="Off at zero. A real H lever rests at the 3/4 gate: this pulls the lever there whenever it is in the neutral channel, fading out with depth so a held gear feels no side pull. Around 25-30% it out-pulls the default column detent and humps and a released lever walks home from anywhere in the channel; below that it is a lean rather than a return. It follows the gear layout, so mirrored columns move home with the gears. If the lever trembles parked at 3/4, lower it - like every pull toward a place, it is only stable in moderation." />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="The pull into a column is light while you slide along the channel and rises in one straight line to the full slot wall by the time you have left it, so the same dial also sets how firmly an entry taken slightly off a column is steered onto its slot. There is no force at all across a column's own width, so it guides without giving the lever a centre line to hunt around. It has no separate funnel strength: a second waypoint would either make one leg steeper than the walls or land exactly on this line." />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="SLOT DETENT" ShowSeparator="True" Visibility="{Binding IsPrnd, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Margin="0,4,0,8">
                                <local:DetentCurveVisualizer x:Name="DetentCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <ui:TitledSlider Title="Resistance entering the slot (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="22" Value="{Binding DetentResistPct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Pull into the slot, the snick (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="35" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Value="{Binding DetentPullPct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Seated hold, keeps the gear in (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="55" Value="{Binding DetentHoldPct, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="The seated hold has to beat whatever the base does by itself. A base that is still self-centring pulls hard at full deflection, and a light hold loses to it - the gear simply falls back out." />
                                <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="This is what makes a gear feel like it clicks into place, the way a real gearbox does - not just friction holding the lever, but a shaped force that changes three times on the way in. Push toward a gear and it resists at first, like pushing into a spring. Keep pushing past that resistance and the lever gets pulled the rest of the way in on its own - the snick, the same moment a synchro drops into place in a real box. Once seated, a steady hold keeps the gear from slipping back out, even against a base that is still trying to nudge the stick back to centre. The graph is the whole stroke in axis counts from centre, so it gets shorter as the throw does, and the white dot tracks exactly where in that sequence the stick currently is." />
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </styles:SHSection>
                        <styles:SHSection Title="SOFTWARE STABILITY" ShowSeparator="True">
                            <StackPanel Margin="0,6,0,16">
                                <ui:TitledSlider Title="Wall attack (ms to full force, 0 = off)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="0" Value="{Binding WallAttackMs, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Rebound absorption (%)" Minimum="0" Maximum="80" TickFrequency="5" ShowResetButton="True" ResetValue="45" Value="{Binding WallYieldPct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Wall friction (%)" Minimum="0" Maximum="40" TickFrequency="1" ShowResetButton="True" ResetValue="15" Value="{Binding WallFrictionPct, Mode=TwoWay}" />
                                <ui:TitledSlider Title="Damping (%)" Minimum="0" Maximum="80" TickFrequency="5" ShowResetButton="True" ResetValue="25" Value="{Binding DampingPct, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="Wall attack eases contact in time. Rebound absorption limits a bounce. Wall friction adds grip only where the gate applies force. Software damping resists motion throughout travel. These extra software controls work in both virtual modes." />
                            </StackPanel>
                        </styles:SHSection>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
            <ContentControl x:Name="GeometryDialogHolder">
                <Grid x:Name="GeometryPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,4,12,8">
                        <local:GateVisualizer x:Name="GeometryGate" Height="250" HorizontalAlignment="Center" />
                        <CheckBox x:Name="GeometryPercentToggle" Content="Show lateral distances as % of column spacing" Margin="0,0,0,4" Checked="OnGeometryPercentToggleChanged" Unchecked="OnGeometryPercentToggleChanged" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                        <StackPanel Margin="12,0,12,12">
                            <styles:SHSection Title="GEAR LAYOUT" ShowSeparator="True">
                                <StackPanel Margin="0,6,0,16">
                                    <styles:SHExpander Header="Gear layout">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="Pure preference: which end of the gate is first gear. Flip these if the gears come out mirrored from where your hand expects them. In sequential the second one swaps up and down; in the automatic it turns the lane round, so P is nearest you instead of furthest away. The buttons follow the labels either way, so mirroring never costs a rebind." />
                                            <styles:SHToggleCheckbox IsChecked="{Binding MirrorColumns, Mode=TwoWay}" Content="First gear on the right instead of the left" Margin="0,2" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" />
                                            <styles:SHToggleCheckbox IsChecked="{Binding MirrorSlots, Mode=TwoWay}" Content="Odd gears toward me instead of away" Margin="0,2" />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="PATTERN SIZE AND LAYOUT" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,6,0,16">
                                    <ui:TitledSlider Title="Pattern width, side to side (% of stick travel)" Minimum="30" Maximum="100" TickFrequency="1" ShowResetButton="True" ResetValue="100" Value="{Binding PatternWidthPct, Mode=TwoWay}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="Nothing else rescales with it. Slot corridors, wall bites and column doorways are all still the raw counts you set, so narrowing the pattern makes each of them a bigger share of the room between columns - which is why the % of column spacing readouts move when this does, and why the wall bite ceiling in Geometry can start biting. Narrow a long way and check that figure." />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="How much of the stick's side-to-side travel the columns are spread over. At 100% the outer columns sit at the very ends, which is where every pattern used to be. Lower it and the pattern is squeezed in from both sides, keeping its middle where it was, so a shift across the gate is a shorter reach - the gate above shows it happening. It is mainly for the three-column patterns: 5+R and the truck 6 put half as many columns across the same stick as 7+R does, so at full width they feel sprawling next to a real five-speed. Around 67% gives them the same spacing a 7+R has." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="CORRIDORS AND WALL SHAPE" ShowSeparator="True">
                                <StackPanel Margin="0,6,0,16">
                                    <StackPanel Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                        <ui:TitledSlider Title="Slot width, free corridor (axis counts)" Minimum="0" Maximum="2400" TickFrequency="100" ShowResetButton="True" ResetValue="1100" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding SlotHalfWidth, Mode=TwoWay}" />
                                        <ui:TitledSlider Title="Slot width, free corridor (% of column spacing)" Minimum="0" Maximum="12" TickFrequency="0.5" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding SlotHalfWidthPercent, Mode=TwoWay}" />
                                        <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="A slot is a corridor with walls, not a pull toward its centre line. If a middle gear shakes while seated, widen this: a narrow corridor leaves the stick balanced on a point it can hunt around. The outer gears never shake because their wall only pushes one way, against the end of travel. Zero is the rail gate: the lever pulled straight onto the column line, like the native shifter mode - stable only with a moderate slot wall, so if a railed gear trembles, lower the wall force first." />
                                            </StackPanel>
                                        </styles:SHExpander>
                                    </StackPanel>
                                    <ui:TitledSlider Title="Tunnel depth, free corridor (axis counts)" Minimum="0" Maximum="4000" TickFrequency="100" ShowResetButton="True" ResetValue="2600" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Value="{Binding ChannelFreeDepth, Mode=TwoWay}" />
                                    <TextBlock x:Name="ChannelFreeDepthSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Text="The fore/aft twin of the slot width: how deep the tunnel stays free before its centring force begins. Zero closes the last free space in the gate, so the lever is guided on exactly one axis everywhere - together with zero slot width this is the native shifter-mode topology. Values above the neutral channel enter band are capped to it." />
                                    <ui:TitledSlider Title="Wall bite distance (axis counts)" Minimum="60" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="600" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding WallRamp, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Wall bite distance (% of column spacing)" Minimum="0" Maximum="30" TickFrequency="0.5" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding WallRampPercent, Mode=TwoWay}" />
                                    <TextBlock x:Name="WallRampSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" />
                                    <ui:TitledSlider Title="Gate wall fade width, across a column (axis counts)" Minimum="200" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="1500" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding WallBlend, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Gate wall fade width, across a column (% of column spacing)" Minimum="0" Maximum="30" TickFrequency="0.5" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding WallBlendPercent, Mode=TwoWay}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="How far sideways it takes the fore/aft gate wall to go from open, on a column, to solid between columns. This is the mouth of each slot seen from the tunnel: narrow and the gate snaps shut as you leave a column, wide and every entry feels vague. It is a sideways gradient, so it is also what corners are made of - widen it if corners feel harsh." />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" Text="Which gap the lockout guards is chosen in Geometry; within that gap it still places itself against the near column's band, so sliding across the gate meets it straight away instead of after a long stretch of dead travel (a Both-direction gate sits on the gap's midpoint instead). Its width is in Geometry, and the live monitor draws the band where it actually is." />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="The lateral guide has no ramp of its own any more. Every sideways force in the gate - the pull along the tunnel, the funnel into a slot, the slot wall itself - now rises at the same stiffness as the wall, so a gentler force gets a shorter face instead of a steeper one. Its own ramp was a free parameter, and at the bottom of its range it made the funnel the steepest thing in the gate, three and a half times the wall face, in exactly the place the lever crosses on every shift." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="THROW AND SLOT END-STOP" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,6,0,16">
                                    <ui:TitledSlider Title="Throw from centre to a seated gear (axis counts)" Minimum="6000" Maximum="30000" TickFrequency="500" ShowResetButton="True" ResetValue="28767" Value="{Binding ThrowFromCentre, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Free landing past the seat (axis counts)" Minimum="0" Maximum="12000" TickFrequency="100" ShowResetButton="True" ResetValue="4000" Value="{Binding SlotOvertravel, Mode=TwoWay}" />
                                    <TextBlock x:Name="SlotThrowSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="How far the lever travels from neutral to a seated gear, and whether it has anywhere to stop. These two questions are the whole of a short-throw box, and they are separate: the throw below sets where a gear registers, but with the end-stop at zero the seated hold keeps pulling past that line and the lever runs on to the base's own mechanical stop, exactly as it always has. Shortening the throw on its own therefore only makes the gear register earlier - the travel is unchanged. Raise the end-stop wall and the slot gets a bottom of its own, which is what actually shortens the throw." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="The slot in order, once it has a bottom: centre to the seat (the throw - it moves the release line with it, so the hysteresis gap survives), then the seated hold fading out over one wall bite, then a free landing carrying no fore/aft force at all, then the wall. The landing is deliberately free rather than held, so the gear's resting place is a region and not a point - a force pulling toward a single spot is an oscillator, which is the same reason the slot corridor and the tunnel are free spaces rather than centre lines. That only works because the base is not self-centring: with Spring at 0 in MOZA Cockpit nothing pushes the lever back out of the landing, so nothing has to hold it in. The landing never runs shorter than the wall bite, whichever way the two are set, or the hold would have to vanish in a couple of counts and arrive as a bang rather than a face." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="SEQUENTIAL STROKE" ShowSeparator="True" Visibility="{Binding IsSequential, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,6,0,16">
                                    <ui:TitledSlider Title="Actuation throw from centre (axis counts)" Minimum="4000" Maximum="30000" TickFrequency="500" ShowResetButton="True" ResetValue="28767" Value="{Binding ThrowFromCentre, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Stroke past the click (axis counts)" Minimum="500" Maximum="10000" TickFrequency="100" ShowResetButton="True" ResetValue="2500" Value="{Binding SeqOvertravel, Mode=TwoWay}" />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="The whole stroke, in order: centre to the firing point (the actuation throw - shorten it for a quicker shift; it moves the re-arm point with it), this much landing past the click, then the end-stop wall rising over the wall bite. The stop is measured from the firing point, so shortening the throw moves everything together. The click kick is a 25 ms burst in the stroke's direction the instant the shift registers - the mechanism letting go - which then throws the lever onto the end-stop: the two together are the thunk, so raise the kick for a harder click and the end-stop wall for a harder landing. Everything stays a wall toward centre, never a pocket: release the lever anywhere and it still comes home. Resistance up to the click is the detent resist dial; what remains after it is detent hold, which is also the spring that brings the lever back." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="SLOT MOUTHS" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,4,0,8">
                                    <local:SlotMouthVisualizer x:Name="SlotMouthCurve" Height="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                    <TextBlock Text="Mouth shape" Margin="0,0,0,4" />
                                    <ComboBox SelectedIndex="{Binding MouthShapeIndex, Mode=TwoWay}" Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="240">
                                        <ComboBoxItem Content="Square - a plain notch (default)" />
                                        <ComboBoxItem Content="Rounded - filleted on both sides" />
                                        <ComboBoxItem Content="Angled - chamfered toward the next gear" />
                                    </ComboBox>
                                    <ui:TitledSlider Title="Mouth reach down the slot (axis counts)" Minimum="1000" Maximum="12000" TickFrequency="500" ShowResetButton="True" ResetValue="5000" Value="{Binding MouthDepth, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Mouth opening (%)" Minimum="0" Maximum="100" TickFrequency="5" ShowResetButton="True" ResetValue="100" Value="{Binding MouthOpenPct, Mode=TwoWay}" />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="The ends of the dividers between slots, where they meet the neutral tunnel. Square is the plain rectangular notch the gate has always had. The other two open the slot out toward the tunnel, which a hand reads as an eased or a chamfered edge - they only ever remove force, never add it, so the shaping guides rather than shoves. The diagram below is a view from above: depth into the slot running right, how much lateral room there is either side of the column running up and down. The white dot tracks the stick while it is actually in a column." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="Reach is what decides whether the shaping is felt at all. The base takes three to four milliseconds to answer, in which a lever being shifted covers fifteen hundred counts or more - so shaping confined to a shorter stretch than that is over before a single corrected force arrives. Several thousand counts spans the whole withdrawal stroke. Opening is a share of what the geometry safely allows, so it can never reach the next column's slot or the lockout's band. Angled opens one side only, toward the next gear in sequence, and does nothing at all where there is no next gear or where the crossing is the lockout." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="PRND LANE AND LOCKOUT" ShowSeparator="True" Visibility="{Binding IsPrnd, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,6,0,16">
                                    <ui:TitledSlider Title="Lane half-length from centre (axis counts)" Minimum="2000" Maximum="30000" TickFrequency="500" ShowResetButton="True" ResetValue="12000" Value="{Binding PrndLaneHalfLength, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Free notch at each position (axis counts)" Minimum="0" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="600" Value="{Binding PrndNotchHalfWidth, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <TextBlock Text="Lockout between positions" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="220" HorizontalAlignment="Left" SelectedIndex="{Binding PrndLockoutGapIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Off" />
                                            <ComboBoxItem Content="Between P and R" />
                                            <ComboBoxItem Content="Between R and N" />
                                            <ComboBoxItem Content="Between N and D" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasPrndLockout, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Direction" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding PrndLockoutDirectionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="One-way - moving toward D pays" />
                                                <ComboBoxItem Content="One-way - moving toward P pays" />
                                                <ComboBoxItem Content="Both ways pay" />
                                            </ComboBox>
                                        </StackPanel>
                                        <ui:TitledSlider Title="PRND lockout half-width (axis counts)" Minimum="200" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="1200" Value="{Binding PrndLockoutHalfWidth, Mode=TwoWay}" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6" Text="The lockout names the labels, so turning the lane round with the mirror option moves it with P, R, N and D. Its band replaces that gap's detent hump and is clamped to end before both neighbouring notches - the line below says what is actually in force." />
                                    </StackPanel>
                                    <TextBlock x:Name="PrndLaneSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" />
                                    <styles:SHExpander Header="How these settings work" Margin="0,8,0,8">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="An automatic's selector: one lane with four fixed positions. Direct vJoy holds P/R/N/D on buttons 11/12/13/14; Control Mapper holds the role assigned to each position in Options. There is no neutral to come back through and no gear to engage: the lever is always somewhere, and moving between positions is all there is." />
                                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="The lane half-length puts P and D that far either side of centre, with the other two dividing the rest evenly - it is the lane's own dial, not the throw the H and sequential patterns share, because a selector lane is a fraction of the length a gear lever wants and sharing one would retune the other every time the pattern changed. The detent between positions is a smooth hump: nothing at a position, nothing again at the halfway point, one rise either side. That is deliberate rather than decorative - a force pulling toward the nearest position would reverse at every halfway point, and a reversal between two saturated forces is the worst step this hardware can produce. The free notch is what makes a selected position a place the lever rests rather than a point it is pulled to; zero turns each position into a line, which is stable only at moderate detent force, like the rail gate. Sideways the lever is railed to the middle at the slot wall strength." />
                                        </StackPanel>
                                    </styles:SHExpander>
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHSection Title="LOCKOUT POSITION AND WIDTH" ShowSeparator="True" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,6,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Lockout position" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding LockoutPlacementIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="Pattern default (7+R and 6+R guard 7/R; others none)" />
                                            <ComboBoxItem Content="Off" />
                                            <ComboBoxItem Content="Between columns 1 and 2" />
                                            <ComboBoxItem Content="Between columns 2 and 3" />
                                            <ComboBoxItem Content="Between columns 3 and 4 (four-column patterns)" />
                                            <ComboBoxItem Content="On one slot (pick the gear below)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsLockoutOnSlot, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Locked slot" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Width="90" SelectedIndex="{Binding LockoutSlotGearIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                            <ComboBoxItem Content="6" />
                                            <ComboBoxItem Content="7" />
                                            <ComboBoxItem Content="R" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsLockoutOnGap, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Direction" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding LockoutGapDirectionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="One-way - entering the higher column pays" />
                                            <ComboBoxItem Content="One-way - entering the lower column pays" />
                                            <ComboBoxItem Content="Both directions pay" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsLockoutOnSlot, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Direction" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox MinWidth="300" HorizontalAlignment="Left" SelectedIndex="{Binding LockoutSlotDirectionIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="One-way - going into the slot pays" />
                                            <ComboBoxItem Content="One-way - coming out of the slot pays" />
                                            <ComboBoxItem Content="Both ways pay" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowsLockoutDials, Converter={StaticResource BoolToVis}}">
                                        <ui:TitledSlider Title="Lockout gate half-width (axis counts)" Minimum="500" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="2200" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding LockoutHalfWidth, Mode=TwoWay}" />
                                        <ui:TitledSlider Title="Lockout gate half-width (% of column spacing)" Minimum="0" Maximum="30" TickFrequency="0.5" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding LockoutHalfWidthPercent, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock x:Name="LockoutPlacementSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Visibility="{Binding ShowsLockoutDials, Converter={StaticResource BoolToVis}}" />
                                    <ui:TitledSlider Title="Hump width (axis counts)" Minimum="400" Maximum="8000" TickFrequency="100" ShowResetButton="True" ResetValue="2500" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding BarrierWidth, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Hump width (% of column spacing)" Minimum="0" Maximum="40" TickFrequency="1" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding BarrierWidthPercent, Mode=TwoWay}" />
                                </StackPanel>
                            </styles:SHSection>
                            <styles:SHExpander Header="Advanced gate geometry">
                                <StackPanel Margin="0,8,0,8">
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="All in axis counts: positions run 0 to 65535 with 32767 at centre, so 1000 counts is about a finger's width of stick travel. These decide where the gate thinks the lever is, not what it feels like - change them only if gear detection is wrong, and use Feel for anything about strength." />
                                    <ui:TitledSlider Title="Neutral tunnel half-depth (enter)" Minimum="200" Maximum="8000" TickFrequency="100" ShowResetButton="True" ResetValue="2600" Value="{Binding ChannelHalfEnter, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Neutral tunnel half-depth (leave)" Minimum="200" Maximum="10000" TickFrequency="100" ShowResetButton="True" ResetValue="5200" Value="{Binding ChannelHalfExit, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Outer column half-width" Minimum="500" Maximum="10000" TickFrequency="100" ShowResetButton="True" ResetValue="2600" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding ColumnEdgeEnter, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Outer column half-width (% of column spacing)" Minimum="0" Maximum="50" TickFrequency="1" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding ColumnEdgeEnterPercent, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Inner column half-width" Minimum="300" Maximum="8000" TickFrequency="100" ShowResetButton="True" ResetValue="1200" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding ColumnInnerHalfEnter, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Inner column half-width (% of column spacing)" Minimum="0" Maximum="40" TickFrequency="1" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding ColumnInnerHalfEnterPercent, Mode=TwoWay}" />
                                    <StackPanel Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}">
                                        <ui:TitledSlider Title="Lockout clearance from the column beside it" Minimum="300" Maximum="10000" TickFrequency="100" ShowResetButton="True" ResetValue="2400" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding ColumnInnerHalfExit, Mode=TwoWay}" />
                                        <ui:TitledSlider Title="Lockout clearance from the column beside it (% of column spacing)" Minimum="0" Maximum="50" TickFrequency="1" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding ColumnInnerHalfExitPercent, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Visibility="{Binding IsHPattern, Converter={StaticResource BoolToVis}}" Text="The lockout clearance above is the room the lockout gate leaves beside the column it stands against before its band begins - whichever gap Geometry points it at. It does nothing while the lockout is off or on a slot; the line under Geometry's lockout dials says which gap is actually guarded." />
                                    <ui:TitledSlider Title="Engage depth (from the end of travel)" Minimum="500" Maximum="28000" TickFrequency="500" ShowResetButton="True" ResetValue="4000" Value="{Binding EngageDepth, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Release depth (from the end of travel)" Minimum="1000" Maximum="30000" TickFrequency="500" ShowResetButton="True" ResetValue="8000" Value="{Binding ReleaseDepth, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Column handover width" Minimum="0" Maximum="6000" TickFrequency="100" ShowResetButton="True" ResetValue="400" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource InverseBoolToVis}}" Value="{Binding DetentHysteresis, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Column handover width (% of column spacing)" Minimum="0" Maximum="30" TickFrequency="0.5" Visibility="{Binding IsChecked, ElementName=GeometryPercentToggle, Converter={StaticResource BoolToVis}}" Value="{Binding DetentHysteresisPercent, Mode=TwoWay}" />
                                    <ui:TitledSlider Title="Ticks required to engage" Minimum="1" Maximum="20" TickFrequency="1" ShowResetButton="True" ResetValue="2" Value="{Binding MinEngageTicks, Mode=TwoWay}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="How many consecutive loop ticks the lever must sit past the engage depth before the gear registers, so a single stray reading cannot fire a shift. Ticks use the loop rate in Options → Diagnostics, so at the default 1000 Hz two ticks is two milliseconds - raise it only if gears register spuriously, because every tick added is delay a hand can feel." />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="How far fore or aft of centre still counts as the neutral tunnel. This is a genuine hysteresis pair - the lever has to travel past the larger figure to be considered out of neutral, and come back inside the smaller one to be back in it, so resting on the boundary cannot flutter the gear. The gap between them is also the distance over which the slot walls fade in as you leave the tunnel, so widening it makes the handover gentler." />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="How wide the opening at each column is, measured either side of its centre line - the outer two get more because they run to the end of travel. Inside it the fore/aft wall is fully open so the lever can go straight into the slot; outside it the wall blends shut over the wall blend distance in Geometry. It is not what decides which gear a push selects: every position in the gate belongs to the column it is nearest, so a push that beats the wall lands in the nearer slot rather than in nothing at all. There is no matching release width: once the lever is in a gear the only way out is back through the tunnel, at any sideways distance whatever." />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="Both measure from the ends of travel, so raising them shortens the throw - centre is 32767, and the shift fires once the lever is within the engage depth of a stop. This is also the sequential lever's activation distance: its spring reaches full resistance exactly at the threshold and the click moves with it, so a short throw stays progressive. Keep the release depth 2000-4000 above the engage depth or the re-arm point sits on top of the firing point." />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8" Text="Nothing to do with the slot detents. Sliding along the tunnel, the sideways pull has to change which column it belongs to at some point, and that swap is a reversal of a force: this is how far either side of the boundary the pull is faded out so the change cannot arrive as a step. It is deliberately small - the whole width is dead space with no sideways guidance, so a wide setting leaves the lever unguided across half the gate." />
                                </StackPanel>
                            </styles:SHExpander>
                            <styles:SHSection Title="RESET GEOMETRY" ShowSeparator="True">
                                <StackPanel Margin="0,6,0,16">
                                    <styles:SHButtonSecondary Content="Reset geometry" Click="OnResetGeometry" Padding="14,6" Margin="0,4,8,4" />
                                </StackPanel>
                            </styles:SHSection>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
            <ContentControl x:Name="EffectsDialogHolder">
                <Grid Margin="8" x:Name="EffectsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" Text="SimHub effects played through the lever. Add, group and tune effects below; every row uses SimHub's response filters, live graph, frequency and priority controls. Effects belong to the selected shifter profile. The lever's overall gain and vibration budget apply to every effect." />
                    <StackPanel x:Name="EffectsMasterPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Effects gain" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Minimum="0" Maximum="100" Width="160" VerticalAlignment="Center" Value="{Binding GlobalGain, Mode=TwoWay}" />
                        <TextBlock Text="{Binding GlobalGain, StringFormat={}{0:0}%}" VerticalAlignment="Center" Margin="8,0,20,0" />
                        <styles:SHToggleCheckbox Content="Mute effects" IsChecked="{Binding IsMuted, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <styles:SHButtonSecondary Click="OnResetEffects" Content="Reset effects to defaults" Padding="12,4" />
                    </StackPanel>
                    <ContentControl x:Name="NativeEffectsEditor" Grid.Row="3" />
                    <styles:SHExpander Header="Clutch bite point for this profile" Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel>
                            <ui:TitledSlider Title="Bite point (% of pedal travel)" Minimum="0" Maximum="100" ResetValue="25" Margin="0,10,0,0" Value="{Binding ClutchBitePointPct, Mode=TwoWay}" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" Text="Where the clutch starts to bite. This is a property of the car rather than of the pedals, so it cannot be measured from the hardware - set it where the car actually picks up. It is what the progressive grind fades across, and what the bite-point pulse on Effects fires on." />
                        </StackPanel>
                    </styles:SHExpander>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
